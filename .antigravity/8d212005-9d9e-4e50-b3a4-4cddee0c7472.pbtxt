   <div className=\"w-7 h-7 rounded bg-[#111110] text-white flex items-center justify-center font-mono font-bold text-xs\">\n              H\n            </div>\n            <span className=\"text-xs font-bold tracking-tight text-[#111110] uppercase font-mono\">\n              Host Financial\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-2 opacity-85 hover:opacity-100 transition-opacity\">\n            <span className=\"material-symbols-outlined text-[#059669] text-[20px]\">\n              verified\n            </span>\n            <span className=\"text-xs font-bold tracking-tight text-[#111110] uppercase font-mono\">\n              AirDNA Verified\n            </span>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
