    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\n\ninterface BeowulfObsidianCtaProps {\n  onOpenTestament: () => void;\n}\n\nexport const BeowulfObsidianCta: React.FC<BeowulfObsidianCtaProps> = ({ onOpenTestament }) => {\n  const [email, setEmail] = useState(\'\');\n  const [dispatched, setDispatched] = useState(false);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!email) return;\n    setDispatched(true);\n    setTimeout(() => {\n      setDispatched(false);\n      setEmail(\'\');\n    }, 3500);\n  };\n\n  return (\n    <section className=\"max-w-[1360px] w-full mx-auto px-6 md:px-10 pb-20\">\n      <div className=\"bg-[#121214] text-white rounded-2xl p-8 md:p-14 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8 border border-neutral-800 shadow-2xl\">\n        {/* Ambient Warm Amber Glow */}\n        <div className=\"absolute -right-16 -top-16 w-80 h-80 bg-[#D97706]/15 rounded-full blur-3xl pointer-events-none\"></div>\n\n        <div className=\"max-w-xl z-10\">\n          <span className=\"text-xs font-mono font-bold text-[#D97706] uppercase tracking-[0.2em] block mb-2\">\n            THE MOUND OF HRONESNESS PROTOCOL\n          </span>\n          <h3 className=\"font-serif text-2xl md:text-4xl font-extrabold mb-3 tracking-tight leading-tight\">\n            \"They reared a mound at the headland of the sea...\"\n          </h3>\n          <p className=\"text-xs md:text-sm text-neutral-300 leading-relaxed font-sans\">\n            Ten days the Geatish warriors built the pyre and barrow, sealing the dragon\'s heathen gold back into the dark earth.\n          </p>\n        </div>\n\n        {/* Integrated Action / Email */}\n        <div className=\"z-10 w-full md:w-auto shrink-0 flex flex-col sm:flex-row gap-3\">\n          <button\n            onClick={onOpenTestament}\n            className=\"inline-flex items-center justify-center font-mono text-xs font-bold uppercase tracking-wider bg-[#D97706] text-[#111110] px-6 py-3 rounded-lg hover:bg-[#D97706]/90 transition-all font-semibold cursor-pointer whitespace-nowrap shadow-md\"\n          >\n            Read Dying Testament \342\206\222\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
