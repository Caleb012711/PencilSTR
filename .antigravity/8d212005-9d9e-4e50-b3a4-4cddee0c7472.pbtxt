  file_change {
    absolute_path_uri: "file:///src/components/ThanesAuditModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { COWARD_THANES_LOG } from \'../data/beowulfData\';\n\ninterface ThanesAuditModalProps {\n  onClose: () => void;\n  onOpenTestament: () => void;\n}\n\nexport const ThanesAuditModal: React.FC<ThanesAuditModalProps> = ({\n  onClose,\n  onOpenTestament,\n}) => {\n  return (\n    <div className=\"fixed inset-0 z-50 overflow-y-auto bg-black/60 backdrop-blur-sm flex items-center justify-center p-4\">\n      <div className=\"bg-white rounded-xl border border-[#E5E4DF] shadow-2xl max-w-2xl w-full overflow-hidden my-auto max-h-[85vh] flex flex-col\">\n        {/* Header */}\n        <div className=\"p-5 border-b border-[#E5E4DF] bg-[#F9F8F5] flex justify-between items-center\">\n          <div>\n            <span className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-[#92400E] block\">\n              COMITATUS LEGAL AUDIT // MEAD-BENCH BREACH\n            </span>\n            <h3 className=\"font-serif text-xl font-bold text-[#111110]\">\n              The Ten Thanes of Earnaness\n            </h3>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1 rounded hover:bg-[#E5E4DF] text-[#666562] transition-colors cursor-pointer\"\n          >\n            <span className=\"material-symbols-outlined text-[20px]\">close</span>\n          </button>\n        </div>\n\n        {/* Content */}\n        <div className=\"p-6 overflow-y-auto space-y-4 text-xs font-mono\">\n          <div className=\"p-4 rounded-lg bg-[#FEF3C7]/40 border border-[#D97706]/30\">\n            <span className=\"text-[10px] font-bold text-[#92400E] uppercase block mb-1\">\n              Wiglaf\'s Pronouncement of Exile (\302\2472884\342\200\223\302\2472891)\n            </span>\n            <p className=\"text-xs text-[#111110] leading-relaxed italic\">\n              \"Now every sharing of treasure and gift of swords, all home-joy shall cease for your kin; every man of your clan must wander landless, stripped of his rights of estate, once the nobles from afar hear of your flight, your dishonorable deed! Death is better for every man than a life of shame!\"\n            </p>\n          </div>\n\n          <div className=\"border border-[#E5E4DF] rounded-lg divide-y divide-[#E5E4DF] overflow-hidden\">\n            <div className=\"px-4 py-2.5 bg-[#F9F8F5] font-bold text-[#666562] text-[10px] uppercase flex justify-between\">\n              <span>Retainer Classification</span>\n              <span>Verdict / Status</span>\n            </div>\n            {COWARD_THANES_LOG.map((thane, idx) => (\n              <div key={idx} className=\"p-4 flex items-start justify-between gap-3 hover:bg-[#F9F8F5]/50\">\n                <div>\n                  <h4 className=\"font-bold text-[#111110] text-sm\">{thane.name}</h4>\n                  <p className=\"text-[#666562] text-[11px] mt-0.5\">{thane.fate}</p>\n                  <span className=\"text-[10px] text-[#8F8D88] block mt-1\">\n                    Forfeited: {thane.gearSurrendered}\n                  </span>\n                </div>\n                <span\n                  className={`text-[10px] font-bold px-2 py-0.5 rounded whitespace-nowrap ${\n                    thane.cowardiceScore.includes(\'SOVEREIGN\')\n                      ? \'bg-[#E8F5EE] text-[#0B3B24]\'\n                      : \'bg-[#FEF3C7] text-[#92400E]\'\n                  }`}\n                >\n                  {thane.cowardiceScore}\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Footer */}\n        <div className=\"p-4 border-t border-[#E5E4DF] bg-[#F9F8F5] flex justify-between items-center\">\n          <button\n            onClick={() => {\n              onClose();\n              onOpenTestament();\n            }}\n            className=\"text-xs font-mono font-bold text-[#0B3B24] hover:underline cursor-pointer\"\n          >\n            Inspect Beowulf\'s Testament \342\206\222\n          </button>\n          <button\n            onClick={onClose}\n            className=\"px-4 py-2 rounded bg-[#111110] text-white text-xs font-mono font-bold uppercase hover:bg-black transition-colors\"\n          >\n            Acknowledge Audit\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
