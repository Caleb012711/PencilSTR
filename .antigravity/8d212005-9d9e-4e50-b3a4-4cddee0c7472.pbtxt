    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { PropertyDeal } from \'../types\';\n\ninterface CaseStudiesSectionProps {\n  allDeals: PropertyDeal[];\n  onSelectDeal: (deal: PropertyDeal) => void;\n  onNavigateToUnderwriter: () => void;\n}\n\nexport const CaseStudiesSection: React.FC<CaseStudiesSectionProps> = ({\n  allDeals,\n  onSelectDeal,\n  onNavigateToUnderwriter,\n}) => {\n  const ridgeDeal = allDeals.find(d => d.id === \'timberline-ridge\') || allDeals[0];\n  const kierlandDeal = allDeals.find(d => d.id === \'kierland-hideaway\') || allDeals[1];\n\n  const handleOpenDeal = (deal: PropertyDeal) => {\n    onSelectDeal(deal);\n    onNavigateToUnderwriter();\n    window.scrollTo({ top: 0, behavior: \'smooth\' });\n  };\n\n  return (\n    <section className=\"max-w-[1360px] w-full mx-auto px-6 md:px-10 py-12\">\n      <div className=\"bg-white p-8 md:p-10 rounded-xl border border-[#E5E4DF] shadow-sm\">\n        <div className=\"max-w-3xl mb-8\">\n          <div className=\"inline-block px-2.5 py-1 bg-[#FEF3C7] text-[#92400E] rounded text-[11px] font-mono font-bold uppercase tracking-wider mb-3\">\n            AUDITED CASE STUDIES // RECENT DEPOSITS\n          </div>\n          <h3 className=\"font-serif text-2xl md:text-3xl font-extrabold text-[#111110] tracking-tight\">\n            From raw MLS link to closed DSCR loan package in 18 minutes.\n          </h3>\n          <p className=\"text-xs md:text-sm text-[#666562] mt-2 leading-relaxed font-sans\">\n            PencilSTR generated bulletproof underwriting memorandums and CC&amp;R validation packets that secured sub-7.2% institutional debt for our operators.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          {/* Deal Card 1: The Ridge Alpine */}\n          <div\n            onClick={() => handleOpenDeal(ridgeDeal)}\n            className=\"rounded-lg border border-[#E5E4DF] bg-[#F9F8F5] overflow-hidden shadow-sm hover:shadow-md hover:border-[#111110]/30 transition-all cursor-pointer group\"\n          >\n            <div className=\"relative aspect-[16/10] overflow-hidden\">\n              <img\n                alt=\"A modern luxury timber architectural cabin with blackened wood cladding, floor-to-ceiling glass windows, warm ambient interior lighting glowing inside, nestled in a misty mountain forest in Gatlinburg Tennessee\"\n                className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]\"\n                src={ridgeDeal.imageUrl}\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-[#111110]/85 via-transparent to-transparent\"></div>\n              <div className=\"absolute bottom-3 left-3 text-white\">\n                <p className=\"text-base font-bold font-sans\">The Ridge Alpine</p>\n                <p className=\"text-xs font-mono text-neutral-300\">Gatlinburg, TN \302\267 4 Bed / 3.5 Bath</p>\n              </div>\n              <div className=\"absolute top-3 right-3 bg-[#0B3B24] text-white text-[11px] font-mono font-bold px-2 py-0.5 rounded shadow-sm\">\n                19.4% CoC\n              </div>\n            </div>\n            <div className=\"p-4 grid grid-cols-4 gap-2 text-center text-xs font-mono bg-white border-t border-[#E5E4DF]\">\n              <div>\n                <span className=\"text-[10px] text-[#8F8D88] block uppercase\">Purchase</span>\n                <span className=\"font-bold text-[#111110]\">$625,000</span>\n              </div>\n              <div>\n                <span className=\"text-[10px] text-[#8F8D88] block uppercase\">Cap Rate</span>\n                <span className=\"font-bold text-[#111110]\">10.8%</span>\n              </div>\n              <div>\n                <span className=\"text-[10px] text-[#8F8D88] block uppercase\">Net NOI</span>\n                <span className=\"font-bold text-[#111110]\">$67,500</span>\n              </div>\n              <div>\n                <span className=\"text-[10px] text-[#8F8D88] block uppercase\">DSCR Loan</span>\n                <span className=\"font-bold text-[#059669]\">7.15% Fixed</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Deal Card 2: Kierland Hideaway */}\n          <div\n            onClick={() => handleOpenDeal(kierlandDeal)}\n            className=\"rounded-lg border border-[#E5E4DF] bg-[#F9F8F5] overflow-hidden shadow-sm hover:shadow-md hover:border-[#111110]/30 transition-all cursor-pointer group\"\n          >\n            <div className=\"relative aspect-[16/10] overflow-hidden\">\n              <img\n                alt=\"A luxury mid-century modern desert villa in Scottsdale Arizona with illuminated swimming pool, desert landscaping with saguaro cacti, limestone walls, warm evening lights glowing.\"\n                className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]\"\n                src={kierlandDeal.imageUrl}\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-[#111110]/85 via-transparent to-transparent\"></div>\n              <div className=\"absolute bottom-3 left-3 text-white\">\n                <p className=\"text-base font-bold font-sans\">Kierland Hideaway</p>\n                <p className=\"text-xs font-mono text-neutral-300\">Scottsdale, AZ \302\267 5 Bed / 4.5 Bath</p>\n              </div>\n              <div className=\"absolute top-3 right-3 bg-[#0B3B24] text-white text-[11px] font-mono font-bold px-2 py-0.5 rounded shadow-sm\">\n                17.1% CoC\n              </div>\n            </div>\n            <div className=\"p-4 grid grid-cols-4 gap-2 text-center text-xs font-mono bg-white border-t border-[#E5E4DF]\">\n              <div>\n                <span className=\"text-[10px] text-[#8F8D88] block uppercase\">Purchase</span>\n                <span className=\"font-bold text-[#111110]\">$890,000</span>\n              </div>\n              <div>\n                <span className=\"text-[10px] text-[#8F8D88] block uppercase\">Cap Rate</span>\n                <span className=\"font-bold text-[#111110]\">9.6%</span>\n              </div>\n              <div>\n                <span className=\"text-[10px] text-[#8F8D88] block uppercase\">Net NOI</span>\n                <span className=\"font-bold text-[#111110]\">$85,440</span>\n              </div>\n              <div>\n                <span className=\"text-[10px] text-[#8F8D88] block uppercase\">DSCR Loan</span>\n                <span className=\"font-bold text-[#059669]\">7.25% Fixed</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
