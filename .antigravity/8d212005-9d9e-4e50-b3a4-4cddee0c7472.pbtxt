  file_change {
    absolute_path_uri: "file:///src/components/ScannerHero.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { FinancingType, PropertyDeal } from \'../types\';\nimport { computeUnderwriting, formatCurrency, formatPercent } from \'../utils/calculator\';\n\ninterface ScannerHeroProps {\n  currentDeal: PropertyDeal;\n  onSelectDeal: (deal: PropertyDeal) => void;\n  allDeals: PropertyDeal[];\n  onOpenLenderMemo: () => void;\n  onNavigateToHoaAudit: () => void;\n  onNavigateToUnderwriter: () => void;\n}\n\nexport const ScannerHero: React.FC<ScannerHeroProps> = ({\n  currentDeal,\n  onSelectDeal,\n  allDeals,\n  onOpenLenderMemo,\n  onNavigateToHoaAudit,\n  onNavigateToUnderwriter,\n}) => {\n  const [urlInput, setUrlInput] = useState(\'\');\n  const [isScanning, setIsScanning] = useState(false);\n  const [scanSuccess, setScanSuccess] = useState(false);\n  const [strategy, setStrategy] = useState<FinancingType>(\'dscr\');\n\n  // Sliders state initialized to currentDeal\n  const [adr, setAdr] = useState<number>(currentDeal.baseAdr);\n  const [occupancy, setOccupancy] = useState<number>(currentDeal.baseOccupancy);\n  const [hoveredMonth, setHoveredMonth] = useState<number | null>(null);\n\n  // Sync state if currentDeal changes\n  React.useEffect(() => {\n    setAdr(currentDeal.baseAdr);\n    setOccupancy(currentDeal.baseOccupancy);\n  }, [currentDeal]);\n\n  // Recalculate metrics in real-time\n  const metrics = useMemo(() => {\n    return computeUnderwriting(currentDeal, adr, occupancy, strategy);\n  }, [currentDeal, adr, occupancy, strategy]);\n\n  const handlePencilDeal = (e?: React.FormEvent) => {\n    if (e) e.preventDefault();\n    setIsScanning(true);\n    setScanSuccess(false);\n\n    setTimeout(() => {\n      setIsScanning(false);\n      setScanSuccess(true);\n\n      // Check if user URL matches any known location, else pick another deal\n      const inputLower = urlInput.toLowerCase();\n      let matched = allDeals.find(d => \n        inputLower.includes(d.location.toLowerCase().split(\',\')[0]) ||\n        inputLower.includes(d.mlsNumber)\n      );\n\n      if (!matched) {\n        // Toggle or load current deal\n        matched = currentDeal;\n      }\n      onSelectDeal(matched);\n\n      setTimeout(() => {\n        setScanSuccess(false);\n      }, 2500);\n    }, 850);\n  };\n\n  const handleBenchmarkClick = (deal: PropertyDeal) => {\n    setUrlInput(`https://www.mls.com/listing/${deal.mlsNumber}/${deal.title.toLowerCase().replace(/\\s+/g, \'-\')}`);\n    onSelectDeal(deal);\n  };\n\n  // Find max monthly revenue for bar chart normalization\n  const maxMonthRev = useMemo(() => {\n    return Math.max(...currentDeal.seasonality.map(m => m.revenue), 15000);\n  }, [currentDeal]);\n\n  return (\n    <div className=\"w-full flex flex-col items-center\">\n      {/* 1. Hero Input & Editorial Typography */}\n      <section className=\"max-w-[1360px] w-full mx-auto px-6 md:px-10 pt-14 pb-6 text-center flex flex-col items-center\">\n        {/* Architectural Pipeline Pill */}\n        <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#E5E4DF] bg-white shadow-sm mb-6\">\n          <span className=\"w-2 h-2 rounded-full bg-[#059669] inline-block animate-pulse\"></span>\n          <span className=\"text-[11px] font-mono font-semibold text-[#666562] tracking-wider uppercase\">\n            ARCHITECTURAL PIPELINE \302\267 42 COHORTS ACTIVE\n          </span>\n          <span className=\"text-[10px] font-mono font-bold text-[#D97706] px-2 py-0.5 bg-[#FEF3C7]/80 rounded-full\">\n            V3.0 AUDIT\n          </span>\n        </div>\n\n        {/* Editorial Headline */}\n        <h1 className=\"font-serif text-4xl sm:text-5xl md:text-[64px] md:leading-[1.1] font-extrabold tracking-[-0.03em] text-[#111110] max-w-4xl mb-5 text-balance\">\n          Stop guessing on Airbnb cash flow. <br />\n          <span className=\"italic font-normal text-[#92400E]\">Underwrite the truth</span> in seconds.\n        </h1>\n\n        <p className=\"text-base md:text-lg text-[#666562] max-w-2xl mx-auto mb-8 leading-relaxed font-sans\">\n          Autonomous deal discovery, multi-tier DSCR financing models, and instant AI CC&R covenant audits before you tour.\n        </p>\n\n        {/* URL Input Form Container */}\n        <form\n          onSubmit={handlePencilDeal}\n          className=\"w-full max-w-3xl bg-white border border-[#E2E0D9] rounded-full p-2.5 shadow-lg flex flex-col sm:flex-row items-center gap-3 transition-all focus-within:border-[#111110]/50\"\n        >\n          <div className=\"flex items-center w-full gap-3 px-4 text-[#111110]\">\n            <span className=\"material-symbols-outlined text-[22px] text-[#8F8D88]\">search</span>\n            <input\n              className=\"w-full bg-transparent text-[#111110] placeholder-[#8F8D88] text-sm md:text-base focus:outline-none font-mono py-1\"\n              placeholder=\"Paste Zillow, Redfin, or MLS listing URL...\"\n              type=\"text\"\n              value={urlInput}\n              onChange={(e) => setUrlInput(e.target.value)}\n            />\n          </div>\n          <button\n            type=\"submit\"\n            disabled={isScanning}\n            className=\"w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2 text-xs font-mono font-bold uppercase tracking-wider bg-[#111110] text-white px-6 py-3 rounded-full hover:bg-black transition-all shadow-sm active:scale-[0.98] cursor-pointer disabled:opacity-80\"\n          >\n            {isScanning ? (\n              <>\n                <span className=\"material-symbols-outlined text-[15px] animate-spin\">refresh</span>\n                <span>Ingesting MLS...</span>\n              </>\n            ) : scanSuccess ? (\n              <>\n                <span className=\"material-symbols-outlined text-[15px] text-[#059669]\">check_circle</span>\n                <span>Model Verified</span>\n              </>\n            ) : (\n              <>\n                <span>Pencil Deal</span>\n                <span className=\"text-[#D97706] font-bold text-sm\">\342\206\265</span>\n              </>\n            )}\n          </button>\n        </form>\n\n        {/* Quick Demo Benchmarks */}\n        <div className=\"flex flex-wrap items-center justify-center gap-2.5 mt-5 text-xs font-mono text-[#666562]\">\n          <span className=\"text-[11px] uppercase tracking-wider font-semibold text-[#8F8D88]\">\n            Benchmarks:\n          </span>\n          {allDeals.map((deal) => (\n            <button\n              key={deal.id}\n              onClick={() => handleBenchmarkClick(deal)}\n              className={`px-3 py-1 border rounded transition-colors shadow-sm cursor-pointer ${\n                currentDeal.id === deal.id\n                  ? \'bg-[#111110] text-white border-[#111110]\'\n                  : \'bg-white border-[#E5E4DF] text-[#111110] hover:border-[#111110]/30\'\n              }`}\n            >\n              {deal.title.split(\' \')[0]} [{deal.location}]\n            </button>\n          ))}\n        </div>\n      </section>\n\n      {/* 2. HERO DASHBOARD (Active Live Underwriting Terminal) */}\n      <section className=\"max-w-[1360px] w-full mx-auto px-6 md:px-10 my-4\">\n        <div className=\"bg-white border border-[#E5E4DF] rounded-xl shadow-2xl overflow-hidden\">\n          {/* Terminal Status Bar */}\n          <div className=\"bg-[#F9F8F5]/80 border-b border-[#E5E4DF] px-5 py-3 flex flex-wrap items-center justify-between gap-3 text-xs font-mono\">\n            <div className=\"flex items-center gap-2.5\">\n              <span className=\"w-2 h-2 rounded-full bg-[#059669]\"></span>\n              <span className=\"font-bold text-[#111110] tracking-wide\">\n                LIVE SCAN COHORT: {currentDeal.marketName.toUpperCase()} \302\267 MLS #{currentDeal.mlsNumber}\n              </span>\n            </div>\n            <div className=\"flex items-center gap-4 text-[#666562] text-[11px]\">\n              <span className=\"flex items-center gap-1.5\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-[#D97706] inline-block\"></span>\n                ONLINE \302\267 LATENCY 140MS\n              </span>\n              <span className=\"hidden sm:inline text-[#8F8D88]\">|</span>\n              <span className=\"hidden sm:inline font-mono\">ELEV: {currentDeal.elevation}</span>\n            </div>\n          </div>\n\n          {/* 2-Column Live Underwriting Terminal */}\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[#E5E4DF]\">\n            {/* Left Sub-Panel: Scanned Deal & Property Card */}\n            <div className=\"lg:col-span-6 p-6 flex flex-col justify-between space-y-5\">\n              <div>\n                {/* Edge-to-edge Property Image with Overlay Tag */}\n                <div className=\"relative rounded-lg overflow-hidden border border-[#E5E4DF] aspect-[16/9] shadow-sm group\">\n                  <img\n                    alt={currentDeal.imageAlt}\n                    className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]\"\n                    src={currentDeal.imageUrl}\n                    referrerPolicy=\"no-referrer\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-[#111110]/85 via-[#111110]/20 to-transparent\"></div>\n\n                  {/* Floating Price Drop Tag */}\n                  {currentDeal.priceDrop && (\n                    <div className=\"absolute top-3 left-3 bg-[#D97706] text-white text-[11px] font-mono font-bold px-2.5 py-1 rounded shadow-sm flex items-center gap-1.5\">\n                      <span className=\"material-symbols-outlined text-[14px]\">trending_down</span>\n                      <span>-{formatCurrency(currentDeal.priceDrop)} Price Drop (MLS #{currentDeal.mlsNumber})</span>\n                    </div>\n                  )}\n\n                  {/* Photo bottom details */}\n                  <div className=\"absolute bottom-3 left-3 right-3 text-white flex items-end justify-between\">\n                    <div>\n                      <span className=\"text-xs font-mono text-[#FEF3C7] font-semibold uppercase tracking-wider block\">\n                        Verified Active Deal\n                      </span>\n                      <h4 className=\"text-xl font-bold font-sans\">{currentDeal.title}</h4>\n                    </div>\n                    <span className=\"font-mono text-2xl font-extrabold text-white tracking-tight tabular-nums\">\n                      {formatCurrency(currentDeal.price)}\n                    </span>\n                  </div>\n                </div>\n\n                {/* Property Specs Bar */}\n                <div className=\"mt-4 p-3 rounded-lg bg-[#F9F8F5] border border-[#E5E4DF] flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-[#111110]\">\n                  <span className=\"font-semibold text-[#666562]\">{currentDeal.location}</span>\n                  <span className=\"text-[#E5E4DF]\">|</span>\n                  <span>{currentDeal.beds} Bed / {currentDeal.baths} Bath</span>\n                  <span className=\"text-[#E5E4DF]\">|</span>\n                  <span>{currentDeal.sqft.toLocaleString()} sq ft</span>\n                  <span className=\"text-[#E5E4DF]\">|</span>\n                  <span className=\"font-bold text-[#059669]\">Turnkey Ready</span>\n                </div>\n              </div>\n\n              {/* 12-Month Seasonality Projected Revenue Chart */}\n              <div className=\"p-4 rounded-lg bg-white border border-[#E5E4DF] shadow-sm\">\n                <div className=\"flex items-center justify-between mb-3 text-xs\">\n                  <div>\n                    <span className=\"font-mono font-bold text-[#111110] uppercase tracking-wider text-[11px] block\">\n                      12-Month Projected Revenue\n                    </span>\n                    <p className=\"text-[11px] text-[#666562] font-mono tabular-nums\">\n                      ${(currentDeal.seasonality[0].revenue / 1000).toFixed(1)}k/mo ({currentDeal.seasonality[0].name.slice(0,3)}) \342\206\222 ${(currentDeal.seasonality.find(s => s.isPeak)?.revenue || 14200)/1000}k/mo (Peak)\n                    </p>\n                  </div>\n                  <span className=\"text-[10px] font-mono font-extrabold bg-[#E8F5EE] text-[#059669] px-2 py-0.5 rounded\">\n                    PEAK: {currentDeal.seasonality.find(s => s.isPeak)?.name.toUpperCase() || \'OCT\'} RUN\n                  </span>\n                </div>\n\n                {/* Seasonality Bar Graph */}\n                <div className=\"h-24 w-full flex items-end gap-1.5 pt-2\">\n                  {currentDeal.seasonality.map((s, idx) => {\n                    const heightPercent = Math.max(Math.round((s.revenue / maxMonthRev) * 100), 20);\n                    const isPeak = s.isPeak;\n                    const isHovered = hoveredMonth === idx;\n\n                    return (\n                      <div\n                        key={idx}\n                        className=\"flex-1 flex flex-col items-center gap-1 group relative cursor-pointer\"\n                        onMouseEnter={() => setHoveredMonth(idx)}\n                        onMouseLeave={() => setHoveredMonth(null)}\n                      >\n                        {/* Hover Tooltip */}\n                        {isHovered && (\n                          <div className=\"absolute -top-10 left-1/2 -translate-x-1/2 bg-[#111110] text-white text-[10px] px-2 py-1 rounded font-mono shadow-md z-20 whitespace-nowrap\">\n                            <span className=\"font-bold\">{s.name}: </span>\n                            <span>{formatCurrency(s.revenue)}</span>\n                            <div className=\"text-[9px] text-[#FEF3C7]\">{s.occupancy}% Occ \302\267 ${s.adr} ADR</div>\n                          </div>\n                        )}\n\n                        <div\n                          className={`w-full rounded-t transition-all ${\n                            isPeak\n                              ? \'bg-[#059669] hover:opacity-90\'\n                              : isHovered\n                              ? \'bg-[#D97706]\'\n                              : s.revenue > 11000\n                              ? \'bg-[#D97706]/75 hover:bg-[#D97706]\'\n                              : \'bg-[#8F8D88]/25 hover:bg-[#8F8D88]/50\'\n                          }`}\n                          style={{ height: `${heightPercent}%` }}\n                        ></div>\n                        <span\n                          className={`text-[9px] font-mono ${\n                            isPeak ? \'font-bold text-[#059669]\' : \'text-[#8F8D88]\'\n                          }`}\n                        >\n                          {s.month}\n                        </span>\n                      </div>\n                    );\n                  })}\n                </div>\n              </div>\n            </div>\n\n            {/* Right Sub-Panel: Live Underwriting & DSCR Engine */}\n            <div className=\"lg:col-span-6 p-6 flex flex-col justify-between space-y-6\">\n              {/* Strategy Selector Segmented Control */}\n              <div>\n                <div className=\"flex items-center justify-between mb-2\">\n                  <span className=\"text-xs font-mono font-bold text-[#666562] uppercase tracking-wider\">\n                    Financing Strategy\n                  </span>\n                  <span className=\"text-[11px] font-mono text-[#8F8D88]\">Model 3.1</span>\n                </div>\n                <div className=\"grid grid-cols-3 gap-1.5 p-1 bg-[#F9F8F5] rounded-lg border border-[#E5E4DF] text-xs font-mono\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setStrategy(\'conventional\')}\n                    className={`py-2 rounded font-medium transition-all cursor-pointer ${\n                      strategy === \'conventional\'\n                        ? \'bg-white text-[#111110] font-bold shadow-sm border border-[#E5E4DF]\'\n                        : \'text-[#666562] hover:text-[#111110]\'\n                    }`}\n                  >\n                    Conventional\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setStrategy(\'dscr\')}\n                    className={`py-2 rounded font-medium transition-all cursor-pointer flex items-center justify-center gap-1.5 ${\n                      strategy === \'dscr\'\n                        ? \'bg-white text-[#111110] font-bold shadow-sm border border-[#E5E4DF]\'\n                        : \'text-[#666562] hover:text-[#111110]\'\n                    }`}\n                  >\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-[#059669]\"></span>\n                    <span>DSCR {metrics.dscrRatio.toFixed(2)}x (Active)</span>\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => setStrategy(\'seller_carry\')}\n                    className={`py-2 rounded font-medium transition-all cursor-pointer ${\n                      strategy === \'seller_carry\'\n                        ? \'bg-white text-[#111110] font-bold shadow-sm border border-[#E5E4DF]\'\n                        : \'text-[#666562] hover:text-[#111110]\'\n                    }`}\n                  >\n                    Seller Carry\n                  </button>\n                </div>\n              </div>\n\n              {/* Key Returns Bar */}\n              <div className=\"p-4 rounded-xl bg-[#F9F8F5] border border-[#E5E4DF] shadow-sm\">\n                <div className=\"grid grid-cols-2 gap-4 divide-x divide-[#E5E4DF]\">\n                  <div>\n                    <span className=\"text-[11px] font-mono font-semibold text-[#666562] uppercase tracking-wider block mb-1\">\n                      Cash-on-Cash Return\n                    </span>\n                    <div className=\"flex items-baseline gap-2\">\n                      <span className=\"font-mono text-3xl font-extrabold text-[#0B3B24] tracking-tight tabular-nums\">\n                        {formatPercent(metrics.cashOnCashReturn)}\n                      </span>\n                      <span className=\"text-xs font-mono font-bold text-[#059669]\">CoC</span>\n                    </div>\n                    <span className=\"text-[11px] font-mono text-[#666562] mt-1 block\">\n                      Tier-1 Yield Zone \302\267 {formatPercent(metrics.capRate)} Cap\n                    </span>\n                  </div>\n                  <div className=\"pl-4\">\n                    <span className=\"text-[11px] font-mono font-semibold text-[#666562] uppercase tracking-wider block mb-1\">\n                      Levered Monthly Flow\n                    </span>\n                    <div className=\"flex items-baseline gap-2\">\n                      <span className=\"font-mono text-3xl font-extrabold text-[#111110] tracking-tight tabular-nums\">\n                        {metrics.netCashFlowMonthly >= 0 ? \'+\' : \'\'}{formatCurrency(metrics.netCashFlowMonthly)}\n                      </span>\n                      <span className=\"text-xs font-mono font-bold text-[#666562]\">/mo</span>\n                    </div>\n                    <span className=\"text-[11px] font-mono text-[#0B3B24] mt-1 block font-bold tabular-nums\">\n                      {formatCurrency(metrics.netCashFlowAnnual)} Annual Net\n                    </span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Interactive Scrubbers */}\n              <div className=\"space-y-4\">\n                {/* ADR Scrubber */}\n                <div>\n                  <div className=\"flex justify-between items-center text-xs font-mono mb-1.5\">\n                    <span className=\"font-bold text-[#111110]\">Average Daily Rate (ADR)</span>\n                    <span className=\"font-bold text-[#111110] bg-[#F9F8F5] px-2 py-0.5 rounded border border-[#E5E4DF] tabular-nums\">\n                      ${adr} / night\n                    </span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min={currentDeal.minCompAdr}\n                    max={currentDeal.peakHighAdr}\n                    value={adr}\n                    onChange={(e) => setAdr(Number(e.target.value))}\n                    className=\"w-full accent-[#111110] cursor-pointer h-2 bg-[#F1EFEB] rounded-lg\"\n                  />\n                  <div className=\"flex justify-between text-[10px] font-mono text-[#8F8D88] mt-1\">\n                    <span>${currentDeal.minCompAdr} Comp Min</span>\n                    <span>${currentDeal.peakHighAdr} Peak High</span>\n                  </div>\n                </div>\n\n                {/* Occupancy Scrubber */}\n                <div>\n                  <div className=\"flex justify-between items-center text-xs font-mono mb-1.5\">\n                    <span className=\"font-bold text-[#111110]\">Stabilized Occupancy</span>\n                    <span className=\"font-bold text-[#111110] bg-[#F9F8F5] px-2 py-0.5 rounded border border-[#E5E4DF] tabular-nums\">\n                      {occupancy}%\n                    </span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min={40}\n                    max={85}\n                    value={occupancy}\n                    onChange={(e) => setOccupancy(Number(e.target.value))}\n                    className=\"w-full accent-[#D97706] cursor-pointer h-2 bg-[#F1EFEB] rounded-lg\"\n                  />\n                  <div className=\"flex justify-between text-[10px] font-mono text-[#8F8D88] mt-1\">\n                    <span>{currentDeal.breakEvenOccupancy}% Break-even DSCR 1.05x</span>\n                    <span>{currentDeal.topMarketOccupancy}% Market Top 10%</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* CC&R Banner Pill */}\n              <div\n                onClick={onNavigateToHoaAudit}\n                className=\"p-3.5 rounded-lg bg-white border border-[#E5E4DF] shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-mono cursor-pointer hover:border-[#111110]/40 transition-colors\"\n                title=\"Click to view full HOA & CC&R AI Audit\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-4 h-4 rounded-full bg-[#0B3B24] text-white flex items-center justify-center text-[10px] font-bold\">\n                    \342\234\223\n                  </span>\n                  <span className=\"font-bold text-[#111110] uppercase tracking-tight\">\n                    {currentDeal.hoaStatus.statusText} ({currentDeal.hoaStatus.section})\n                  </span>\n                </div>\n                {currentDeal.hoaStatus.warningNote && (\n                  <span className=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-[#FEF3C7] text-[#92400E] font-bold text-[11px] border border-[#D97706]/20 self-start sm:self-auto\">\n                    <span className=\"material-symbols-outlined text-[13px]\">warning</span>\n                    {currentDeal.hoaStatus.warningNote}\n                  </span>\n                )}\n              </div>\n\n              {/* Action Buttons: Download Memo & Go to Full Underwriter */}\n              <div className=\"flex flex-col sm:flex-row gap-2.5\">\n                <button\n                  type=\"button\"\n                  onClick={onOpenLenderMemo}\n                  className=\"flex-1 py-3.5 px-6 rounded bg-[#111110] text-white hover:bg-neu