             </button>\n            </>\n          )}\n\n          {/* Mobile hamburger */}\n          <button\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"md:hidden p-1.5 text-[#111110] rounded hover:bg-[#EBEAE6] transition-colors cursor-pointer\"\n            aria-label=\"Toggle Navigation Menu\"\n          >\n            <span className=\"material-symbols-outlined text-[24px]\">\n              {mobileMenuOpen ? \'close\' : \'menu\'}\n            </span>\n          </button>\n        </div>\n      </div>\n\n      {/* Mobile Drawer Menu */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden border-t border-[#EBEAE6] bg-[#F5F4F0] px-6 py-4 space-y-3\">\n          <div className=\"flex gap-2 p-1 bg-white rounded border border-[#E5E4DF] text-xs font-mono mb-2\">\n            <button\n              onClick={() => {\n                onToggleAppMode(\'beowulf\');\n                setMobileMenuOpen(false);\n              }}\n              className={`flex-1 py-1.5 rounded font-bold ${\n                appMode === \'beowulf\' ? \'bg-[#111110] text-white\' : \'text-[#666562]\'\n              }`}\n            >\n              The Dragon &amp; King\n            </button>\n            <button\n              onClick={() => {\n                onToggleAppMode(\'pencilstr\');\n                setMobileMenuOpen(false);\n              }}\n              className={`flex-1 py-1.5 rounded font-bold ${\n                appMode === \'pencilstr\' ? \'bg-[#111110] text-white\' : \'text-[#666562]\'\n              }`}\n            >\n              PencilSTR Terminal\n            </button>\n          </div>\n\n          <div className=\"flex flex-col gap-2 font-medium text-sm\">\n            {appMode === \'beowulf\' ? (\n              <>\n                <button\n                  onClick={() => {\n                    onSelectTab(\'scanner\');\n                    setMobileMenuOpen(false);\n                  }}\n                  className=\"text-left py-2 px-3 rounded font-bold text-[#111110] bg-white\"\n                >\n                  Earnaness Barrow\n                </button>\n                <button\n                  onClick={() => {\n                    if (onOpenTestament) onOpenTestament();\n                    setMobileMenuOpen(false);\n                  }}\n                  className=\"text-left py-2 px-3 rounded text-[#666562]\"\n                >\n                  King\'s Testament\n                </button>\n              </>\n            ) : (\n              <>\n                <button\n                  onClick={() => {\n                    onSelectTab(\'scanner\');\n                    setMobileMenuOpen(false);\n                  }}\n                  className={`text-left py-2 px-3 rounded transition-colors ${\n                    activeTab === \'scanner\' ? \'bg-white font-bold text-[#111110]\' : \'text-[#666562]\'\n                  }`}\n                >\n                  Scanner &amp; Live Radar\n                </button>\n                <button\n                  onClick={() => {\n                    onSelectTab(\'underwriter\');\n                    setMobileMenuOpen(false);\n                  }}\n                  className={`text-left py-2 px-3 rounded transition-colors ${\n                    activeTab === \'underwriter\' ? \'bg-white font-bold text-[#111110]\' : \'text-[#666562]\'\n                  }`}\n                >\n                  DSCR Underwriter Studio\n                </button>\n                <button\n                  onClick={() => {\n                    onSelectTab(\'hoa-audit\');\n                    setMobileMenuOpen(false);\n                  }}\n                  className={`text-left py-2 px-3 rounded transition-colors ${\n                    activeTab === \'hoa-audit\' ? \'bg-white font-bold text-[#111110]\' : \'text-[#666562]\'\n                  }`}\n                >\n                  HOA &amp; Zoning AI Audit\n                </butt