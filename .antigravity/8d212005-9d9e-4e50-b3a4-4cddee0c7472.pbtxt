  file_change {
    absolute_path_uri: "file:///src/components/PricingSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\n\ninterface PricingSectionProps {\n  onStartPlan: (planName: string, price: string) => void;\n}\n\nexport const PricingSection: React.FC<PricingSectionProps> = ({ onStartPlan }) => {\n  const [isAnnual, setIsAnnual] = useState(false);\n\n  const discount = isAnnual ? 0.8 : 1.0;\n\n  return (\n    <section className=\"max-w-[1360px] w-full mx-auto px-6 md:px-10 py-16\" id=\"pricing\">\n      <div className=\"max-w-2xl mx-auto text-center mb-10\">\n        <span className=\"text-xs font-mono font-bold text-[#0B3B24] uppercase tracking-[0.2em] block mb-2\">\n          TRANSPARENT TERMS // SCALABLE\n        </span>\n        <h2 className=\"font-serif text-3xl md:text-4xl font-extrabold text-[#111110] tracking-tight mb-3\">\n          Simple pricing for serious deal hunters.\n        </h2>\n        <p className=\"text-sm text-[#666562] leading-relaxed font-sans mb-6\">\n          Choose the tier that matches your acquisition pace and pipeline scale.\n        </p>\n\n        {/* Monthly / Annual Toggle */}\n        <div className=\"inline-flex items-center gap-3 p-1 bg-white border border-[#E5E4DF] rounded-full shadow-sm\">\n          <button\n            onClick={() => setIsAnnual(false)}\n            className={`px-4 py-1.5 rounded-full text-xs font-mono font-bold transition-all cursor-pointer ${\n              !isAnnual ? \'bg-[#111110] text-white shadow-sm\' : \'text-[#666562] hover:text-[#111110]\'\n            }`}\n          >\n            Monthly Billing\n          </button>\n          <button\n            onClick={() => setIsAnnual(true)}\n            className={`px-4 py-1.5 rounded-full text-xs font-mono font-bold transition-all flex items-center gap-1.5 cursor-pointer ${\n              isAnnual ? \'bg-[#111110] text-white shadow-sm\' : \'text-[#666562] hover:text-[#111110]\'\n            }`}\n          >\n            <span>Annual (Save 20%)</span>\n            <span className=\"w-2 h-2 rounded-full bg-[#059669]\"></span>\n          </button>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch\">\n        {/* Tier 1: Scout */}\n        <div className=\"bg-white p-7 rounded-xl border border-[#E5E4DF] shadow-sm flex flex-col justify-between h-full hover:border-[#111110]/30 transition-all\">\n          <div>\n            <div className=\"mb-6\">\n              <span className=\"text-xs font-mono font-bold text-[#666562] uppercase tracking-wider block mb-2\">\n                TIER 01 / SCOUT\n              </span>\n              <div className=\"flex items-baseline gap-1\">\n                <span className=\"font-mono text-4xl font-extrabold text-[#111110] tabular-nums\">\n                  ${Math.round(29 * discount)}\n                </span>\n                <span className=\"text-xs font-mono text-[#666562]\">/ month</span>\n              </div>\n              <p className=\"text-xs text-[#666562] mt-2 leading-relaxed\">\n                Ideal for solo deal seekers evaluating their initial vacation rental acquisition.\n              </p>\n            </div>\n            <div className=\"space-y-3.5 text-xs font-mono text-[#111110] border-t border-[#E5E4DF] pt-5 mb-8\">\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"material-symbols-outlined text-[16px] text-[#111110]\">check</span>\n                <span>50 Property URL Scans / mo</span>\n              </div>\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"material-symbols-outlined text-[16px] text-[#111110]\">check</span>\n                <span>DSCR &amp; Conventional Models</span>\n              </div>\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"material-symbols-outlined text-[16px] text-[#111110]\">check</span>\n                <span>Standard STR City Ordinance Check</span>\n              </div>\n              <div className=\"flex items-center gap-2.5 text-[#8F8D88]\">\n                <span className=\"material-symbols-outlined text-[16px]\">close</span>\n                <span>No Automated PDF memos</span>\n              </div>\n            </div>\n          </div>\n          <button\n            onClick={() => onStartPlan(\'Scout\', `$${Math.round(29 * discount)}/mo`)}\n            className=\"w-full py-3.5 rounded border border-[#E5E4DF] bg-[#F9F8F5] hover:bg-white hover:border-[#111110] text-[#111110] font-mono text-xs font-bold uppercase tracking-wider transition-colors text-center shadow-sm cursor-pointer\"\n          >\n            Start Free\n          </button>\n        </div>\n\n        {/* Tier 2: Operator (FEATURED) */}\n        <div className=\"bg-white rounded-xl border-2 border-[#D97706] shadow-xl flex flex-col justify-between h-full relative transform lg:-translate-y-2\">\n          <div className=\"p-7 flex-1 flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center justify-between mb-3\">\n                <span className=\"text-xs font-mono font-bold text-[#92400E] uppercase tracking-wider block\">\n                  TIER 02 / OPERATOR\n                </span>\n                <span className=\"text-[10px] font-mono font-extrabold px-2.5 py-0.5 rounded-full bg-[#D97706] text-white tracking-wide uppercase shadow-sm\">\n                  MOST POPULAR\n                </span>\n              </div>\n              <div className=\"flex items-baseline gap-1 mb-2\">\n                <span className=\"font-mono text-4xl font-extrabold text-[#111110] tabular-nums\">\n                  ${Math.round(79 * discount)}\n                </span>\n                <span className=\"text-xs font-mono text-[#666562]\">/ month</span>\n              </div>\n              <p className=\"text-xs text-[#666562] leading-relaxed\">\n                For active portfolio builders submitting competitive offers on weekly sweeps.\n              </p>\n              <div className=\"space-y-3.5 text-xs font-mono text-[#111110] border-t border-[#E5E4DF] pt-5 my-6\">\n                <div className=\"flex items-center gap-2.5\">\n                  <span className=\"w-3.5 h-3.5 rounded-full bg-[#0B3B24] text-white flex items-center justify-center text-[9px] font-bold\">\n                    \342\234\223\n                  </span>\n                  <span className=\"font-bold\">Unlimited Real-time URL Scans</span>\n                </div>\n                <div className=\"flex items-center gap-2.5\">\n                  <span className=\"w-3.5 h-3.5 rounded-full bg-[#0B3B24] text-white flex items-center justify-center text-[9px] font-bold\">\n                    \342\234\223\n                  </span>\n                  <span>Daily MLS Price Cut Radar Alerts</span>\n                </div>\n                <div className=\"flex items-center gap-2.5\">\n                  <span className=\"w-3.5 h-3.5 rounded-full bg-[#0B3B24] text-white flex items-center justify-center text-[9px] font-bold\">\n                    \342\234\223\n                  </span>\n                  <span>Full CC&amp;R &amp; Zoning AI Audit Engine</span>\n                </div>\n                <div className=\"flex items-center gap-2.5\">\n                  <span className=\"w-3.5 h-3.5 rounded-full bg-[#0B3B24] text-white flex items-center justify-center text-[9px] font-bold\">\n                    \342\234\223\n                  </span>\n                  <span>Seller &amp; Creative Financing Modules</span>\n                </div>\n                <div className=\"flex items-center gap-2.5\">\n                  <span className=\"w-3.5 h-3.5 rounded-full bg-[#0B3B24] text-white flex items-center justify-center text-[9px] font-bold\">\n                    \342\234\223\n                  </span>\n                  <span>1-Click Lender Memo PDF Export</span>\n                </div>\n              </div>\n            </div>\n            <button\n              onClick={() => onStartPlan(\'Operator\', `$${Math.round(79 * discount)}/mo`)}\n              className=\"w-full py-3.5 rounded bg-[#111110] hover:bg-black text-white font-mono text-xs font-bold uppercase tracking-wider transition-all text-center shadow-md cursor-pointer\"\n            >\n              Get Started \342\206\222\n            </button>\n          </div>\n        </div>\n\n        {/* Tier 3: Desk / Fund */}\n        <div className=\"bg-white p-7 rounded-xl border border-[#E5E4DF] shadow-sm flex flex-col justify-between h-full hover:border-[#111110]/30 transition-all\">\n          <div>\n            <div className=\"mb-6\">\n              <span className=\"text-xs font-mono font-bold text-[#666562] uppercase tracking-wider block mb-2\">\n                TIER 03 / DESK / FUND\n              </span>\n              <div className=\"flex items-baseline gap-1\">\n                <span className=\"font-mono text-4xl font-extrabold text-[#111110] tabular-nums\">\n                  ${Math.round(199 * discount)}\n                </span>\n                <span className=\"text-xs font-mono text-[#666562]\">/ month</span>\n              </div>\n              <p className=\"text-xs text-[#666562] mt-2 leading-relaxed\">\n                Multi-seat team access for syndicates, private equity funds, and boutique brokerages.\n              </p>\n            </div>\n            <div className=\"space-y-3.5 text-xs font-mono text-[#111110] border-t border-[#E5E4DF] pt-5 mb-8\">\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"material-symbols-outlined text-[16px] text-[#111110]\">check</span>\n                <span>5 Dedicated Team Seats</span>\n              </div>\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"material-symbols-outlined text-[16px] text-[#111110]\">check</span>\n                <span>Custom Wholesaler Feed Ingestion</span>\n              </div>\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"material-symbols-outlined text-[16px] text-[#111110]\">check</span>\n                <span>White-label Client Investment Memos</span>\n              </div>\n              <div className=\"flex items-center gap-2.5\">\n                <span className=\"material-symbols-outlined text-[16px] text-[#111110]\">check</span>\n                <span>Direct REST &amp; Webhook API Access</span>\n              </div>\n            </div>\n          </div>\n          <button\n            onClick={() => onStartPlan(\'Desk / Fund\', `$${Math.round(199 * discount)}/mo`)}\n            className=\"w-full py-3.5 rounded border border-[#E5E4DF] bg-[#F9F8F5] hover:bg-white hover:border-[#111110] text-[#111110] font-mono text-xs font-bold uppercase tracking-wider transition-colors text-center shadow-sm cursor-pointer\"\n          >\n            Contact Team\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
