    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\n\ninterface NavbarProps {\n  activeTab: \'scanner\' | \'underwriter\' | \'hoa-audit\' | \'pricing\';\n  onSelectTab: (tab: \'scanner\' | \'underwriter\' | \'hoa-audit\' | \'pricing\') => void;\n  savedDealsCount: number;\n  onOpenPipeline: () => void;\n  onOpenAuthModal: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  activeTab,\n  onSelectTab,\n  savedDealsCount,\n  onOpenPipeline,\n  onOpenAuthModal,\n}) => {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  return (\n    <header className=\"sticky top-0 w-full z-50 bg-[#F5F4F0]/90 backdrop-blur-md border-b border-[#EBEAE6]\">\n      <div className=\"h-16 w-full max-w-[1360px] mx-auto px-6 md:px-10 flex items-center justify-between\">\n        {/* Brand Zone */}\n        <button\n          onClick={() => {\n            onSelectTab(\'scanner\');\n            window.scrollTo({ top: 0, behavior: \'smooth\' });\n          }}\n          className=\"flex items-center gap-2 group text-left cursor-pointer focus:outline-none\"\n        >\n          <span className=\"font-extrabold tracking-tight text-lg text-[#111110] font-sans\">\n            PENCIL\n          </span>\n          <span className=\"text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-[#D97706]/15 text-[#92400E] tracking-wide\">\n            STR\n          </span>\n        </button>\n\n        {/* Navigation Links Zone */}\n        <nav className=\"hidden md:flex items-center gap-8 text-[13px] font-medium text-[#666562]\">\n          <button\n            onClick={() => onSelectTab(\'scanner\')}\n            className={`transition-colors cursor-pointer py-1 ${\n              activeTab === \'scanner\'\n                ? \'text-[#111110] font-semibold border-b-2 border-[#111110]\'\n                : \'hover:text-[#111110]\'\n            }`}\n          >\n            Scanner\n          </button>\n          <button\n            onClick={() => onSelectTab(\'underwriter\')}\n            className={`transition-colors cursor-pointer py-1 ${\n              activeTab === \'underwriter\'\n                ? \'text-[#111110] font-semibold border-b-2 border-[#111110]\'\n                : \'hover:text-[#111110]\'\n            }`}\n          >\n            Underwriter\n          </button>\n          <button\n            onClick={() => onSelectTab(\'hoa-audit\')}\n            className={`transition-colors cursor-pointer py-1 ${\n              activeTab === \'hoa-audit\'\n                ? \'text-[#111110] font-semibold border-b-2 border-[#111110]\'\n                : \'hover:text-[#111110]\'\n            }`}\n          >\n            HOA Audit\n          </button>\n          <button\n            onClick={() => onSelectTab(\'pricing\')}\n            className={`transition-colors cursor-pointer py-1 ${\n              activeTab === \'pricing\'\n                ? \'text-[#111110] font-semibold border-b-2 border-[#111110]\'\n                : \'hover:text-[#111110]\'\n            }`}\n          >\n            Pricing\n          </button>\n        </nav>\n\n        {/* Actions Zone */}\n        <div className=\"flex items-center gap-3\">\n          {savedDealsCount > 0 && (\n            <button\n              onClick={onOpenPipeline}\n              className=\"inline-flex items-center gap-1.5 text-xs font-mono font-semibold px-2.5 py-1.5 rounded border border-[#E5E4DF] bg-white text-[#111110] hover:bg-[#F9F8F5] transition-colors shadow-sm\"\n              title=\"View Saved Pipeline\"\n            >\n              <span>Pipeline</span>\n              <span className=\"w-4 h-4 rounded-full bg-[#0B3B24] text-white flex items-center justify-center text-[10px] font-bold\">\n                {savedDealsCount}\n              </span>\n            </button>\n          )}\n\n          <button\n            onClick={onOpenAuthModal}\n            className=\"text-xs font-semibold text-[#666562] hover:text-[#111110] transition-colors hidden sm:inline cursor-pointer\"\n          >\n            Log in\n          </button>\n\n          <button\n            onClick={() => onSelectTab(\'pricing\')}\n            className=\"inline-flex items-center justify-center text-xs font-semibold rounded bg-[#111110] text-white px-4 py-2 hover:bg-black transition-all shadow-sm cursor-pointer whitespace-nowrap\"\n          >\n            Start Free Trial \342\206\222\n          </button>\n\n          {/* Mobile hamburger */}\n          <button\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"md:hidden p-1.5 text-[#111110] rounded hover:bg-[#EBEAE6] transition-colors\"\n            aria-label=\"Toggle Navigation Menu\"\n          >\n            <span className=\"material-symbols-outlined text-[24px]\">\n              {mobileMenuOpen ? \'close\' : \'menu\'}\n            </span>\n          </button>\n        </div>\n      </div>\n\n      {/* Mobile Drawer Menu */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden border-t border-[#EBEAE6] bg-[#F5F4F0] px-6 py-4 space-y-3\">\n          <div className=\"flex flex-col gap-2 font-medium text-sm\">\n            <button\n              onClick={() => {\n                onSelectTab(\'scanner\');\n                setMobileMenuOpen(false);\n              }}\n              className={`text-left py-2 px-3 rounded transition-colors ${\n                activeTab === \'scanner\' ? \'bg-white font-bold text-[#111110]\' : \'text-[#666562]\'\n              }`}\n            >\n              Scanner & Live Radar\n            </button>\n            <button\n              onClick={() => {\n                onSelectTab(\'underwriter\');\n                setMobileMenuOpen(false);\n              }}\n              className={`text-left py-2 px-3 rounded transition-colors ${\n                activeTab === \'underwriter\' ? \'bg-white font-bold text-[#111110]\' : \'text-[#666562]\'\n              }`}\n            >\n              DSCR Underwriter Studio\n            </button>\n            <button\n              onClick={() => {\n                onSelectTab(\'hoa-audit\');\n                setMobileMenuOpen(false);\n              }}\n              className={`text-left py-2 px-3 rounded transition-colors ${\n                activeTab === \'hoa-audit\' ? \'bg-white font-bold text-[#111110]\' : \'text-[#666562]\'\n              }`}\n            >\n              HOA & Zoning AI Audit\n            </button>\n            <button\n              onClick={() => {\n                onSelectTab(\'pricing\');\n                setMobileMenuOpen(false);\n              }}\n              className={`text-left py-2 px-3 rounded transition-colors ${\n                activeTab === \'pricing\' ? \'bg-white font-bold text-[#111110]\' : \'text-[#666562]\'\n              }`}\n            >\n              Pricing & Tiers\n            </button>\n          </div>\n          <div className=\"pt-2 border-t border-[#EBEAE6] flex justify-between items-center text-xs\">\n            <button\n              onClick={() => {\n                onOpenAuthModal();\n                setMobileMenuOpen(false);\n              }}\n              className=\"text-[#666562] font-semibold\"\n            >\n              Log in to account\n            </button>\n            {savedDealsCount > 0 && (\n              <button\n                onClick={() => {\n                  onOpenPipeline();\n                  setMobileMenuOpen(false);\n                }}\n                className=\"text-[#0B3B24] font-bold\"\n              >\n                Saved Deals ({savedDealsCount})\n              </button>\n            )}\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};"
      replacement_content: "import React, { useState } from \'react\';\n\ninterface NavbarProps {\n  appMode: \'beowulf\' | \'pencilstr\';\n  onToggleAppMode: (mode: \'beowulf\' | \'pencilstr\') => void;\n  activeTab: \'scanner\' | \'underwriter\' | \'hoa-audit\' | \'pricing\';\n  onSelectTab: (tab: \'scanner\' | \'underwriter\' | \'hoa-audit\' | \'pricing\') => void;\n  savedDealsCount: number;\n  onOpenPipeline: () => void;\n  onOpenAuthModal: () => void;\n  onOpenTestament?: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  appMode,\n  onToggleAppMode,\n  activeTab,\n  onSelectTab,\n  savedDealsCount,\n  onOpenPipeline,\n  onOpenAuthModal,\n  onOpenTestament,\n}) => {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  return (\n    <header className=\"sticky top-0 w-full z-50 bg-[#F5F4F0]/90 backdrop-blur-md border-b border-[#EBEAE6]\">\n      <div className=\"h-16 w-full max-w-[1360px] mx-auto px-6 md:px-10 flex items-center justify-between\">\n        {/* Brand Zone */}\n        <div className=\"flex items-center gap-4\">\n          <button\n            onClick={() => {\n              onSelectTab(\'scanner\');\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            className=\"flex items-center gap-2 group text-left cursor-pointer focus:outline-none\"\n          >\n            <span className=\"font-extrabold tracking-tight text-lg text-[#111110] font-sans\">\n              {appMode === \'beowulf\' ? \'BEOWULF\' : \'PENCIL\'}\n            </span>\n            <span className=\"text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-[#D97706]/15 text-[#92400E] tracking-wide\">\n              {appMode === \'beowulf\' ? \'PART 3 \360\237\220\211\' : \'STR\'}\n            </span>\n          </button>\n\n          {/* Mode Switcher Pill */}\n          <div className=\"hidden sm:inline-flex items-center p-0.5 rounded-full border border-[#E5E4DF] bg-white text-[11px] font-mono font-bold shadow-xs\">\n            <button\n              onClick={() => onToggleAppMode(\'beowulf\')}\n              className={`px-3 py-1 rounded-full transition-all cursor-pointer ${\n                appMode === \'beowulf\'\n                  ? \'bg-[#111110] text-white shadow-xs\'\n                  : \'text-[#666562] hover:text-[#111110]\'\n              }`}\n            >\n              The Dragon &amp; King\n            </button>\n            <button\n              onClick={() => onToggleAppMode(\'pencilstr\')}\n              className={`px-3 py-1 rounded-full transition-all cursor-pointer ${\n                appMode === \'pencilstr\'\n                  ? \'bg-[#111110] text-white shadow-xs\'\n                  : \'text-[#666562] hover:text-[#111110]\'\n              }`}\n            >\n              PencilSTR Terminal\n            </button>\n          </div>\n        </div>\n\n        {/* Navigation Links Zone */}\n        <nav className=\"hidden md:flex items-center gap-8 text-[13px] font-medium text-[#666562]\">\n          {appMode === \'beowulf\' ? (\n            <>\n              <button\n                onClick={() => {\n                  onSelectTab(\'scanner\');\n                  window.scrollTo({ top: 0, behavior: \'smooth\' });\n                }}\n                className=\"text-[#111110] font-semibold transition-colors cursor-pointer py-1 border-b-2 border-[#111110]\"\n              >\n                Earnaness Barrow\n              </button>\n              <button\n                onClick={onOpenTestament}\n                className=\"hover:text-[#111110] transition-colors cursor-pointer py-1\"\n              >\n                King\'s Testament\n              </button>\n              <button\n                onClick={() => {\n                  const el = document.getElementById(\'beowulf-codex\');\n                  if (el) el.scrollIntoView({ behavior: \'smooth\' });\n                }}\n                className=\"hover:text-[#111110] transition-colors cursor-pointer py-1\"\n              >\n                Three Figures\n              </button>\n              <button\n                onClick={() => onToggleAppMode(\'pencilstr\')}\n                className=\"hover:text-[#111110] transition-colors cursor-pointer py-1 text-[#92400E] font-mono text-xs\"\n              >\n                Switch to STR Model \342\206\222\n              </button>\n            </>\n          ) : (\n            <>\n              <button\n                onClick={() => onSelectTab(\'scanner\')}\n                className={`transition-colors cursor-pointer py-1 ${\n                  activeTab === \'scanner\'\n                    ? \'text-[#111110] font-semibold border-b-2 border-[#111110]\'\n                    : \'hover:text-[#111110]\'\n                }`}\n              >\n                Scanner\n              </button>\n              <button\n                onClick={() => onSelectTab(\'underwriter\')}\n                className={`transition-colors cursor-pointer py-1 ${\n                  activeTab === \'underwriter\'\n                    ? \'text-[#111110] font-semibold border-b-2 border-[#111110]\'\n                    : \'hover:text-[#111110]\'\n                }`}\n              >\n                Underwriter\n              </button>\n              <button\n                onClick={() => onSelectTab(\'hoa-audit\')}\n                className={`transition-colors cursor-pointer py-1 ${\n                  activeTab === \'hoa-audit\'\n                    ? \'text-[#111110] font-semibold border-b-2 border-[#111110]\'\n                    : \'hover:text-[#111110]\'\n                }`}\n              >\n                HOA Audit\n              </button>\n              <button\n                onClick={() => onSelectTab(\'pricing\')}\n                className={`transition-colors cursor-pointer py-1 ${\n                  activeTab === \'pricing\'\n                    ? \'text-[#111110] font-semibold border-b-2 border-[#111110]\'\n                    : \'hover:text-[#111110]\'\n                }`}\n              >\n                Pricing\n              </button>\n            </>\n          )}\n        </nav>\n\n        {/* Actions Zone */}\n        <div className=\"flex items-center gap-3\">\n          {appMode === \'pencilstr\' && savedDealsCount > 0 && (\n            <button\n              onClick={onOpenPipeline}\n              className=\"inline-flex items-center gap-1.5 text-xs font-mono font-semibold px-2.5 py-1.5 rounded border border-[#E5E4DF] bg-white text-[#111110] hover:bg-[#F9F8F5] transition-colors shadow-sm cursor-pointer\"\n              title=\"View Saved Pipeline\"\n            >\n              <span>Pipeline</span>\n              <span className=\"w-4 h-4 rounded-full bg-[#0B3B24] text-white flex items-center justify-center text-[10px] font-bold\">\n                {savedDealsCount}\n              </span>\n            </button>\n          )}\n\n          {appMode === \'beowulf\' ? (\n            <button\n              onClick={onOpenTestament}\n              className=\"inline-flex items-center justify-center text-xs font-semibold rounded bg-[#111110] text-white px-4 py-2 hover:bg-black transition-all shadow-sm cursor-pointer whitespace-nowrap\"\n            >\n              Beowulf\'s Testament \342\206\222\n            </button>\n          ) : (\n            <>\n              <button\n                onClick={onOpenAuthModal}\n                className=\"text-xs font-semibold text-[#666562] hover:text-[#111110] transition-colors hidden sm:inline cursor-pointer\"\n              >\n                Log in\n              </button>\n\n              <button\n                onClick={() => onSelectTab(\'pricing\')}\n                className=\"inline-flex items-center justify-center text-xs font-semibold rounded bg-[#111110] text-white px-4 py-2 hover:bg-black transition-all shadow-sm cursor-pointer whitespace-nowrap\"\n              >\n                Start Free Trial \342\206\222\n              </button>\n            </>\n          )}\n\n          {/* Mobile hamburger */}\n          <button\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"md:hidden p-1.5 text-[#111110] rounded hover:bg-[#EBEAE6] transition-colors cursor-pointer\"\n            aria-label=\"Toggle Navigation Menu\"\n          >\n            <span className=\"material-symbols-outlined text-[24px]\">\n              {mobileMenuOpen ? \'close\' : \'menu\'}\n            </span>\n          </button>\n        </div>\n      </div>\n\n      {/* Mobile Drawer Menu */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden border-t border-[#EBEAE6] bg-[#F5F4F0] px-6 py-4 space-y-3\">\n          <div className=\"flex gap-2 p-1 bg-white rounded border border-[#E5E4DF] text-xs font-mono mb-2\">\n            <button\n              onClick={() => {\n                onToggleAppMode(\'beowulf\');\n                setMobileMenuOpen(false);\n              }}\n              className={`flex-1 py-1.5 rounded font-bold ${\n                appMode === \'beowulf\' ? \'bg-[#111110] text-white\' : \'text-[#666562]\'\n              }`}\n            >\n              The Dragon &amp; King\n            </button>\n            <button\n              onClick={() => {\n                onToggleAppMode(\'pencilstr\');\n                setMobileMenuOpen(false);\n              }}\n              className={`flex-1 py-1.5 rounded font-bold ${\n                appMode === \'pencilstr\' ? \'bg-[#111110] text-white\' : \'text-[#666562]\'\n              }`}\n            >\n              PencilSTR Terminal\n            </button>\n          </div>\n\n          <div className=\"flex flex-col gap-2 font-medium text-sm\">\n            {appMode === \'beowulf\' ? (\n              <>\n                <button\n                  onClick={() => {\n                    onSelectTab(\'scanner\');\n                    setMobileMenuOpen(false);\n                  }}\n                  className=\"text-left py-2 px-3 rounded font-bold text-[#111110] bg-white\"\n                >\n                  Earnaness Barrow\n                </button>\n                <button\n                  onClick={() => {\n                    if (onOpenTestament) onOpenTestament();\n                    setMobileMenuOpen(false);\n                  }}\n                  className=\"text-left py-2 px-3 rounded text-[#666562]\"\n                >\n                  King\'s Testament\n                </button>\n              </>\n            ) : (\n              <>\n                <button\n                  onClick={() => {\n                    onSelectTab(\'scanner\');\n                    setMobileMenuOpen(false);\n                  }}\n                  className={`text-left py-2 px-3 rounded transition-colors ${\n                    activeTab === \'scanner\' ? \'bg-white font-bold text-[#111110]\' : \'text-[#666562]\'\n                  }`}\n                >\n                  Scanner &amp; Live Radar\n                </button>\n                <button\n                  onClick={() => {\n                    onSelectTab(\'underwriter\');\n                    setMobileMenuOpen(false);\n                  }}\n                  className={`text-left py-2 px-3 rounded transition-colors ${\n                    activeTab === \'underwriter\' ? \'bg-white font-bold text-[#111110]\' : \'text-[#666562]\'\n                  }`}\n                >\n                  DSCR Underwriter Studio\n                </button>\n                <button\n                  onClick={() => {\n                    onSelectTab(\'hoa-audit\');\n                    setMobileMenuOpen(false);\n                  }}\n                  className={`text-left py-2 px-3 rounded transition-colors ${\n                    activeTab === \'hoa-audit\' ? \'bg-white font-bold text-[#111110]\' : \'text-[#666562]\'\n                  }`}\n                >\n                  HOA &amp; Zoning AI Audit\n                </button>\n                <button\n                  onClick={() => {\n                    onSelectTab(\'pricing\');\n                    setMobileMenuOpen(false);\n                  }}\n                  className={`text-left py-2 px-3 rounded transition-colors ${\n                    activeTab === \'pricing\' ? \'bg-white font-bold text-[#111110]\' : \'text-[#666562]\'\n                  }`}\n                >\n                  Pricing &amp; Tiers\n                </button>\n              </>\n            )}\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    }
