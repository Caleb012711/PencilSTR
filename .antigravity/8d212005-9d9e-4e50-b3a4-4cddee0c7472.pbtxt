  file_change {
    absolute_path_uri: "file:///src/components/UnderwriterStudio.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { FinancingType, PropertyDeal } from \'../types\';\nimport { calculateMonthlyMortgage, computeUnderwriting, formatCurrency, formatPercent } from \'../utils/calculator\';\n\ninterface UnderwriterStudioProps {\n  currentDeal: PropertyDeal;\n  allDeals: PropertyDeal[];\n  onSelectDeal: (deal: PropertyDeal) => void;\n  onOpenLenderMemo: () => void;\n  onSaveDeal: (deal: PropertyDeal) => void;\n  isSaved: boolean;\n}\n\nexport const UnderwriterStudio: React.FC<UnderwriterStudioProps> = ({\n  currentDeal,\n  allDeals,\n  onSelectDeal,\n  onOpenLenderMemo,\n  onSaveDeal,\n  isSaved,\n}) => {\n  const [strategy, setStrategy] = useState<FinancingType>(\'dscr\');\n\n  // Input states\n  const [purchasePrice, setPurchasePrice] = useState<number>(currentDeal.price);\n  const [adr, setAdr] = useState<number>(currentDeal.baseAdr);\n  const [occupancy, setOccupancy] = useState<number>(currentDeal.baseOccupancy);\n  const [downPaymentPct, setDownPaymentPct] = useState<number>(\n    currentDeal.financingPreset.dscr.downPaymentPercent\n  );\n  const [interestRate, setInterestRate] = useState<number>(\n    currentDeal.financingPreset.dscr.interestRate\n  );\n  const [managementFeeRate, setManagementFeeRate] = useState<number>(\n    currentDeal.expenses.managementFeeRate * 100\n  );\n  const [renovationBudget, setRenovationBudget] = useState<number>(0);\n\n  // Update when currentDeal changes\n  React.useEffect(() => {\n    setPurchasePrice(currentDeal.price);\n    setAdr(currentDeal.baseAdr);\n    setOccupancy(currentDeal.baseOccupancy);\n    const preset = currentDeal.financingPreset[strategy];\n    setDownPaymentPct(preset.downPaymentPercent);\n    setInterestRate(preset.interestRate);\n    setManagementFeeRate(currentDeal.expenses.managementFeeRate * 100);\n  }, [currentDeal, strategy]);\n\n  // Handle strategy switch\n  const handleStrategyChange = (newStrategy: FinancingType) => {\n    setStrategy(newStrategy);\n    const preset = currentDeal.financingPreset[newStrategy];\n    setDownPaymentPct(preset.downPaymentPercent);\n    setInterestRate(preset.interestRate);\n  };\n\n  // Build adjusted deal object for calculation\n  const adjustedDeal: PropertyDeal = useMemo(() => {\n    return {\n      ...currentDeal,\n      price: purchasePrice + renovationBudget,\n      expenses: {\n        ...currentDeal.expenses,\n        managementFeeRate: managementFeeRate / 100,\n      }\n    };\n  }, [currentDeal, purchasePrice, renovationBudget, managementFeeRate]);\n\n  // Live metrics\n  const metrics = useMemo(() => {\n    return computeUnderwriting(\n      adjustedDeal,\n      adr,\n      occupancy,\n      strategy,\n      downPaymentPct,\n      interestRate\n    );\n  }, [adjustedDeal, adr, occupancy, strategy, downPaymentPct, interestRate]);\n\n  // Sensitivity Matrix calculations\n  const adrMultipliers = [-0.15, -0.075, 0, 0.075, 0.15];\n  const occVariations = [occupancy - 10, occupancy - 5, occupancy, occupancy + 5, occupancy + 10];\n\n  const loanAmount = adjustedDeal.price * (1 - downPaymentPct / 100);\n  const downPaymentDollars = adjustedDeal.price * (downPaymentPct / 100);\n\n  return (\n    <div className=\"w-full max-w-[1360px] mx-auto px-6 md:px-10 py-10\">\n      {/* Top Header & Property Switcher */}\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 pb-6 border-b border-[#E5E4DF]\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-2\">\n            <span className=\"text-[11px] font-mono font-bold px-2 py-0.5 rounded bg-[#0B3B24]/10 text-[#0B3B24] uppercase tracking-wider\">\n              FINANCIAL ARCHITECTURE // WORKSTATION\n            </span>\n            <span className=\"text-xs font-mono text-[#8F8D88]\">\302\267 MLS #{currentDeal.mlsNumber}</span>\n          </div>\n          <h1 className=\"font-serif text-3xl md:text-4xl font-extrabold text-[#111110]\">\n            {currentDeal.title}\n          </h1>\n          <p className=\"text-sm font-mono text-[#666562] mt-1\">\n            {currentDeal.location} \302\267 {currentDeal.beds} Bed / {currentDeal.baths} Bath \302\267 {currentDeal.sqft.toLocaleString()} sqft\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          {/* Quick Select another deal */}\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-mono text-[#8F8D88] hidden sm:inline\">Cohort:</span>\n            <select\n              value={currentDeal.id}\n              onChange={(e) => {\n                const target = allDeals.find(d => d.id === e.target.value);\n                if (target) onSelectDeal(target);\n              }}\n              className=\"bg-white border border-[#E5E4DF] rounded px-3 py-2 text-xs font-mono font-semibold text-[#111110] focus:outline-none focus:border-[#111110] cursor-pointer\"\n            >\n              {allDeals.map((d) => (\n                <option key={d.id} value={d.id}>\n                  {d.title} ({d.location})\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <button\n            onClick={() => onSaveDeal(currentDeal)}\n            className={`px-4 py-2 rounded text-xs font-mono font-bold transition-all flex items-center gap-1.5 cursor-pointer ${\n              isSaved\n                ? \'bg-[#0B3B24] text-white\'\n                : \'bg-white border border-[#E5E4DF] text-[#111110] hover:bg-[#F9F8F5]\'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-[16px]\">\n              {isSaved ? \'bookmark_added\' : \'bookmark_add\'}\n            </span>\n            <span>{isSaved ? \'In Pipeline\' : \'Save Deal\'}</span>\n          </button>\n\n          <button\n            onClick={onOpenLenderMemo}\n            className=\"px-4 py-2 rounded bg-[#111110] text-white text-xs font-mono font-bold uppercase tracking-wider hover:bg-black transition-all flex items-center gap-1.5 cursor-pointer shadow-sm\"\n          >\n            <span className=\"material-symbols-outlined text-[16px] text-[#D97706]\">description</span>\n            <span>Lender Memo (PDF)</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Grid: Inputs + Pro Forma Ledger */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n        {/* Left Column: Underwriting Parameters (5 cols) */}\n        <div className=\"lg:col-span-5 space-y-6\">\n          {/* Strategy Tabs */}\n          <div className=\"bg-white p-5 rounded-xl border border-[#E5E4DF] shadow-sm\">\n            <span className=\"text-[11px] font-mono font-bold text-[#666562] uppercase tracking-wider block mb-2\">\n              Debt Structure &amp; Underwriting Model\n            </span>\n            <div className=\"grid grid-cols-3 gap-1.5 p-1 bg-[#F9F8F5] rounded-lg border border-[#E5E4DF] text-xs font-mono\">\n              <button\n                type=\"button\"\n                onClick={() => handleStrategyChange(\'dscr\')}\n                className={`py-2 rounded font-medium transition-all cursor-pointer ${\n                  strategy === \'dscr\'\n                    ? \'bg-white text-[#111110] font-bold shadow-sm border border-[#E5E4DF]\'\n                    : \'text-[#666562] hover:text-[#111110]\'\n                }`}\n              >\n                DSCR Loan\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleStrategyChange(\'conventional\')}\n                className={`py-2 rounded font-medium transition-all cursor-pointer ${\n                  strategy === \'conventional\'\n                    ? \'bg-white text-[#111110] font-bold shadow-sm border border-[#E5E4DF]\'\n                    : \'text-[#666562] hover:text-[#111110]\'\n                }`}\n              >\n                Conventional\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleStrategyChange(\'seller_carry\')}\n                className={`py-2 rounded font-medium transition-all cursor-pointer ${\n                  strategy === \'seller_carry\'\n                    ? \'bg-white text-[#111110] font-bold shadow-sm border border-[#E5E4DF]\'\n                    : \'text-[#666562] hover:text-[#111110]\'\n                }`}\n              >\n                Seller Carry\n              </button>\n            </div>\n            <p className=\"text-[11px] font-mono text-[#8F8D88] mt-3\">\n              {strategy === \'dscr\' && \'Underwritten strictly on property cash flow without W2 or personal income verification.\'}\n              {strategy === \'conventional\' && \'Standard agency conforming 30-year fixed loan requiring full borrower tax returns.\'}\n              {strategy === \'seller_carry\' && \'Custom seller-financed loan structure with balloon period and negotiated terms.\'}\n            </p>\n          </div>\n\n          {/* Acquisition & Capital Stack Parameters */}\n          <div className=\"bg-white p-5 rounded-xl border border-[#E5E4DF] shadow-sm space-y-4\">\n            <span className=\"text-[11px] font-mono font-bold text-[#111110] uppercase tracking-wider block border-b border-[#E5E4DF] pb-2\">\n              Capital Stack &amp; Acquisition Inputs\n            </span>\n\n            <div>\n              <div className=\"flex justify-between text-xs font-mono mb-1\">\n                <span className=\"text-[#666562]\">Purchase Contract Price</span>\n                <span className=\"font-bold text-[#111110] tabular-nums\">{formatCurrency(purchasePrice)}</span>\n              </div>\n              <input\n                type=\"range\"\n                min={300000}\n                max={1500000}\n                step={5000}\n                value={purchasePrice}\n                onChange={(e) => setPurchasePrice(Number(e.target.value))}\n                className=\"w-full accent-[#111110] cursor-pointer\"\n              />\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-xs font-mono mb-1\">\n                <span className=\"text-[#666562]\">Renovation &amp; Furnishing CapEx</span>\n                <span className=\"font-bold text-[#111110] tabular-nums\">{formatCurrency(renovationBudget)}</span>\n              </div>\n              <input\n                type=\"range\"\n                min={0}\n                max={100000}\n                step={2500}\n                value={renovationBudget}\n                onChange={(e) => setRenovationBudget(Number(e.target.value))}\n                className=\"w-full accent-[#111110] cursor-pointer\"\n              />\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-3 pt-2\">\n              <div>\n                <label className=\"text-[11px] font-mono text-[#666562] block mb-1\">Down Payment %</label>\n                <div className=\"relative\">\n                  <input\n                    type=\"number\"\n                    min={10}\n                    max={50}\n                    step={1}\n                    value={downPaymentPct}\n                    onChange={(e) => setDownPaymentPct(Number(e.target.value))}\n                    className=\"w-full bg-[#F9F8F5] border border-[#E5E4DF] rounded px-3 py-1.5 text-xs font-mono font-bold text-[#111110] focus:outline-none focus:border-[#111110]\"\n                  />\n                  <span className=\"absolute right-3 top-1.5 text-xs font-mono text-[#8F8D88]\">%</span>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"text-[11px] font-mono text-[#666562] block mb-1\">Interest Rate %</label>\n                <div className=\"relative\">\n                  <input\n                    type=\"number\"\n                    min={4.0}\n                    max={12.0}\n                    step={0.05}\n                    value={interestRate}\n                    onChange={(e) => setInterestRate(Number(e.target.value))}\n                    className=\"w-full bg-[#F9F8F5] border border-[#E5E4DF] rounded px-3 py-1.5 text-xs font-mono font-bold text-[#111110] focus:outline-none focus:border-[#111110]\"\n                  />\n                  <span className=\"absolute right-3 top-1.5 text-xs font-mono text-[#8F8D88]\">%</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Capital Stack Visual Bar */}\n            <div className=\"pt-3 border-t border-[#E5E4DF]\">\n              <div className=\"flex justify-between text-[11px] font-mono mb-1.5\">\n                <span className=\"text-[#8F8D88] uppercase\">Capital Stack Distribution</span>\n                <span className=\"font-bold text-[#111110] tabular-nums\">{formatCurrency(metrics.totalCashRequired)} Total Cash Needed</span>\n              </div>\n              <div className=\"w-full h-3 rounded-full flex overflow-hidden border border-[#E5E4DF]\">\n                <div\n                  className=\"bg-[#111110] h-full transition-all\"\n                  style={{ width: `${100 - downPaymentPct}%` }}\n                  title={`Loan Principal: ${formatCurrency(loanAmount)}`}\n                ></div>\n                <div\n                  className=\"bg-[#D97706] h-full transition-all\"\n                  style={{ width: `${downPaymentPct * 0.8}%` }}\n                  title={`Down Payment: ${formatCurrency(downPaymentDollars)}`}\n                ></div>\n                <div\n                  className=\"bg-[#059669] h-full transition-all\"\n                  style={{ width: `${downPaymentPct * 0.2}%` }}\n                  title=\"Reserves & Closing Costs\"\n                ></div>\n              </div>\n              <div className=\"flex justify-between text-[10px] font-mono text-[#666562] mt-1.5\">\n                <span>Principal: {formatCurrency(loanAmount)}</span>\n                <span>Down: {formatCurrency(downPaymentDollars)}</span>\n                <span>Reserves: {formatCurrency(currentDeal.capitalStack.reserves)}</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Operational STR Drivers */}\n          <div className=\"bg-white p-5 rounded-xl border border-[#E5E4DF] shadow-sm space-y-4\">\n            <span className=\"text-[11px] font-mono font-bold text-[#111110] uppercase tracking-wider block border-b border-[#E5E4DF] pb-2\">\n              Operational STR Drivers\n            </span>\n\n            <div>\n              <div className=\"flex justify-between text-xs font-mono mb-1\">\n                <span className=\"text-[#666562]\">Average Daily Rate (ADR)</span>\n                <span className=\"font-bold text-[#111110] tabular-nums\">${adr} / night</span>\n              </div>\n              <input\n                type=\"range\"\n                min={250}\n                max={900}\n                step={5}\n                value={adr}\n                onChange={(e) => setAdr(Number(e.target.value))}\n                className=\"w-full accent-[#111110] cursor-pointer\"\n              />\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-xs font-mono mb-1\">\n                <span className=\"text-[#666562]\">Annualized Occupancy</span>\n                <span className=\"font-bold text-[#111110] tabular-nums\">{occupancy}%</span>\n              </div>\n              <input\n                type=\"range\"\n                min={35}\n                max={90}\n                step={1}\n                value={occupancy}\n                onChange={(e) => setOccupancy(Number(e.target.value))}\n                className=\"w-full accent-[#D97706] cursor-pointer\"\n              />\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-xs font-mono mb-1\">\n                <span className=\"text-[#666562]\">Management Fee (Co-host / Self)</span>\n                <span className=\"font-bold text-[#111110] tabular-nums\">{managementFeeRate}%</span>\n              </div>\n              <input\n                type=\"range\"\n                min={0}\n                max={25}\n                step={1}\n                value={managementFeeRate}\n                onChange={(e) => setManagementFeeRate(Number(e.target.value))}\n                className=\"w-full accent-[#059669] cursor-pointer\"\n              />\n              <div className=\"flex justify-between text-[10px] font-mono text-[#8F8D88] mt-1\">\n                <span>0% (Self-Managed)</span>\n                <span>15% (Co-Host Standard)</span>\n                <span>25% (Full-Service Turnkey)</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: Pro Forma Income Statement & Returns (7 cols) */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          {/* Executive Return Cards */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n            <div className=\"bg-white p-4 rounded-xl border border-[#E5E4DF] shadow-sm\">\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-[#8F8D88] block\">\n                Cash on Cash\n              </span>\n              <div className=\"text-2xl font-mono font-extrabold text-[#0B3B24] tracking-tight mt-1 tabular-nums\">\n                {formatPercent(metrics.cashOnCashReturn)}\n              </div>\n              <span className=\"text-[10px] font-mono text-[#059669] block mt-0.5\">Annualized ROI</span>\n            </div>\n\n            <div className=\"bg-white p-4 rounded-xl border border-[#E5E4DF] shadow-sm\">\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-[#8F8D88] block\">\n                DSCR Ratio\n              </span>\n              <div className=\"text-2xl font-mono font-extrabold text-[#111110] tracking-tight mt-1 tabular-nums\">\n                {metrics.dscrRatio.toFixed(2)}x\n              </div>\n              <span className={`text-[10px] font-mono block mt-0.5 ${metrics.dscrRatio >= 1.25 ? \'text-[#059669]\' : \'text-[#D97706]\'}`}>\n                {metrics.dscrRatio >= 1.25 ? \'\342\234\223 Meets 1.25x Min\' : \'\342\232\240 Below 1.25x Min\'}\n              </span>\n            </div>\n\n            <div className=\"bg-white p-4 rounded-xl border border-[#E5E4DF] shadow-sm\">\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-[#8F8D88] block\">\n                Cap Rate\n              </span>\n              <div className=\"text-2xl font-mono font-extrabold text-[#111110] tracking-tight mt-1 tabular-nums\">\n                {formatPercent(metrics.capRate)}\n              </div>\n              <span className=\"text-[10px] font-mono text-[#666562] block mt-0.5\">Unlevered Yield</span>\n            </div>\n\n            <div className=\"bg-white p-4 rounded-xl border border-[#E5E4DF] shadow-sm\">\n              <span className=\"text-[10px] font-mono uppercase tracking-wider text-[#8F8D88] block\">\n                Monthly Net\n              </span>\n              <div className=\"text-2xl font-mono font-extrabold text-[#111110] tracking-tight mt-1 tabular-nums\">\n                {metrics.netCashFlowMonthly >= 0 ? \'+\' : \'\'}{formatCurrency(metrics.netCashFlowMonthly)}\n              </div>\n              <span className=\"text-[10px] font-mono text-[#0B3B24] block mt-0.5 font-bold tabular-nums\">\n                {formatCurrency(metrics.netCashFlowAnnual)} /yr\n              </span>\n            </div>\n          </div>\n\n          {/* Pro Forma Ledger Table */}\n          <div className=\"bg-white rounded-xl border border-[#E5E4DF] shadow-sm overflow-hidden\">\n            <div className=\"px-5 py-3.5 bg-[#F9F8F5] border-b border-[#E5E4DF] flex justify-between items-center text-xs font-mono\">\n              <span className=\"font-bold text-[#111110] uppercase tracking-wider\">\n                Full Pro Forma Ledger (Year 1)\n              </span>\n              <span className=\"text-[#8F8D88]\">Tabular Figures (USD)</span>\n            </div>\n\n            <div className=\"divide-y divide-[#E5E4DF] text-xs font-mono\">\n              {/* REVENUE SECTION */}\n              <div className=\"p-3 bg-[#F9F8F5]/40 font-bold text-[#666562] uppercase text-[10px] tracking-wider\">\n                Operating Revenue\n              </div>\n              <div className=\"px-5 py-2.5 flex justify-between items-center hover:bg-[#F9F8F5]/60\">\n                <span className=\"text-[#111110]\">Gross Rental Revenue ({Math.round(365 * (occupancy/100))} nights @ ${adr})</span>\n                <span className=\"font-bold text-[#111110] tabular-nums\">{formatCurrency(metrics.grossAnnualRevenue)}</span>\n              </div>\n              <div className=\"px-5 py-2.5 flex justify-between items-center hover:bg-[#F9F8F5]/60\">\n                <span className=\"text-[#111110]\">Guest Cleaning Fees Collected (Pass-Through)</span>\n                <span className=\"font-bold text-[#111110] tabular-nums\">{formatCurrency(metrics.cleaningRevenue)}</span>\n              </div>\n              <div className=\"px-5 py-2.5 flex justify-between items-center bg-[#E8F5EE]/40 font-bold\">\n                <span className=\"text-[#0B3B24]\">Gross Potential Revenue (GPI)</span>\n                <span className=\"text-[#0B3B24] tabular-nums\">{formatCurrency(metrics.totalRevenue)}</span>\n              </div>\n\n              {/* EXPENSES SECTION */}\n              <div className=\"p-3 bg-[#F9F8F5]/40 font-bold text-[#666562] uppercase text-[10px] tracking-wider\">\n                Operating Expenses\n              </div>\n              <div className=\"px-5 py-2.5 flex justify-between items-center hover:bg-[#F9F8F5]/60\">\n                <span className=\"text-[#666562]\">OTA Platform Fees (Airbnb / VRBO 3%)</span>\n                <span className=\"text-[#111110] tabular-nums\">-{formatCurrency(metrics.grossAnnualRevenue * 0.03)}</span>\n              </div>\n              <div className=\"px-5 py-2.5 flex justify-between items-center hover:bg-[#F9F8F5]/60\">\n                <span className=\"text-[#666562]\">Property Management Fee ({managementFeeRate}%)</span>\n                <span className=\"text-[#111110] tabular-nums\">-{formatCurrency(metrics.grossAnnualRevenue * (managementFeeRate / 100))}</span>\n              </div>\n              <div className=\"px-5 py-2.5 flex justify-between items-center hover:bg-[#F9F8F5]/60\">\n                <span className=\"text-[#666562]\">Cleaning Turnover Expense</span>\n                <span className=\"text-[#111110] tabular-nums\">-{formatCurrency(metrics.cleaningRevenue)}</span>\n              </div>\n              <div className=\"px-5 py-2.5 flex justify-between items-center hover:bg-[#F9F8F5]/60\">\n                <span className=\"text-[#666562]\">Property Taxes (Annual)</span>\n                <span className=\"text-[#111110] tabular-nums\">-{formatCurrency(currentDeal.expenses.propertyTaxesAnnual)}</span>\n              </div>\n              <div className=\"px-5 py-2.5 flex justify-between items-center hover:bg-[#F9F8F5]/60\">\n                <span className=\"text-[#666562]\">Commercial STR &amp; Hazard Insurance</span>\n                <span className=\"text-[#111110] tabular-nums\">-{formatCurrency(currentDeal.expenses.insuranceAnnual)}</span>\n              </div>\n              <div className=\"px-5 py-2.5 flex justify-between items-center hover:bg-[#F9F8F5]/60\">\n                <span className=\"text-[#666562]\">Utilities, High-Speed WiFi, Hot Tub Service</span>\n                <span className=\"text-[#111110] tabular-nums\">-{formatCurrency(currentDeal.expenses.utilitiesMonthly * 12)}</span>\n              </div>\n              <div className=\"px-5 py-2.5 flex justify-between items-center hover:bg-[#F9F8F5]/60\">\n                <span className=\"text-[#666562]\">Maintenance Reserve &amp; CapEx (5%)</span>\n                <span className=\"text-[#111110] tabular-nums\">-{formatCurrency(metrics.grossAnnualRevenue * 0.05)}</span>\n              </div>\n              <div className=\"px-5 py-2.5 flex justify-between items-center bg-[#FEF3C7]/40 font-bold\">\n                <span className=\"text-[#92400E]\">Total Operating Expenses</span>\n                <span className=\"text-[#92400E] tabular-nums\">-{formatCurrency(metrics.operatingExpenses)}</span>\n              </div>\n\n              {/* NET OPERATING INCOME */}\n              <div className=\"px-5 py-3 flex justify-between items-center bg-[#F9F8F5] font-extrabold text-sm border-t-2 border-[#E5E4DF]\">\n                <span className=\"text-[#111110]\">Net Operating Income (NOI)</span>\n                <span className=\"text-[#0B3B24] tabular-nums text-base\">{formatCurrency(metrics.noi)}</span>\n              </div>\n\n              {/* DEBT SERVICE */}\n              <div className=\"px-5 py-2.5 flex justify-between items-center hover:bg-[#F9F8F5]/60\">\n                <span className=\"text-[#666562]\">Annual Principal &amp; Interest ({interestRate}% Fixed)</span>\n                <span className=\"text-[#111110] font-bold tabular-nums\">-{formatCurrency(metrics.annualDebtService)}</span>\n              </div>\n\n              {/* BOTTOM LINE */}\n              <div className=\"px-5 py-4 flex justify-between items-center bg-[#111110] text-white font-extrabold text-sm rounded-b-xl\">\n                <div>\n                  <span className=\"block uppercase tracking-wider text-[11px] text-[#FEF3C7]\">Levered Cash Flow Before Tax</span>\n                  <span className=\"text-xs font-normal text-neutral-300\">Monthly P&amp;I: {formatCurrency(metrics.monthlyDebtService)}/mo</span>\n                </div>\n                <div className=\"text-right\">\n                  <span className=\"text-lg text-white tabular-nums block font-mono\">\n                    {metrics.netCashFlowAnnual >= 0 ? \'+\' : \'\'}{formatCurrency(metrics.netCashFlowAnnual)}\n                  </span>\n                  <span className=\"text-xs text-[#059669] font-mono\">\n                    +{formatCurrency(metrics.netCashFlowMonthly)}/mo\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Sensitivity Matrix Table */}\n          <div className=\"bg-white p-5 rounded-xl border border-[#E5E4DF] shadow-sm\">\n            <div className=\"flex justify-between items-center mb-3\">\n              <div>\n                <span className=\"text-[11px] font-mono font-bold text-[#111110] uppercase tracking-wider block\">\n                  Sensitivity Matrix: CoC Yield Stress Test\n                </span>\n                <p className=\"text-[11px] text-[#8F8D88] font-mono\">\n                  Matrix cross-referencing ADR changes against Occupancy drops\n                </p>\n              </div>\n              <span className=\"text-[10px] font-mono text-[#0B3B24] font-bold bg-[#E8F5EE] px-2 py-0.5 rounded\">\n                Dynamic Matrix\n              </span>\n            </div>\n\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-xs font-mono text-center\">\n                <thead>\n                  <tr className=\"border-b border-[#E5E4DF] bg-[#F9F8F5]\">\n                    <th className=\"py-2 px-2 text-left font-semibold text-[#8F8D88]\">Occupancy \\ ADR</th>\n                    {adrMultipliers.map((m, idx) => {\n                      const testAdr = Math.round(adr * (1 + m));\n                      return (\n                        <th key={idx} className=\"py-2 px-2 font-semibold text-[#111110]\">\n                          ${testAdr}\n                          <span className=\"block text-[9px] text-[#8F8D88]\">\n                            {m === 0 ? \'Base\' : m > 0 ? `+${(m*100).toFixed(0)}%` : `${(m*100).toFixed(0)}%`}\n                          </span>\n                        </th>\n                      );\n                    })}\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-[#E5E4DF]\">\n                  {occVariations.map((occVal, rIdx) => {\n                    const isBaseOcc = occVal === occupancy;\n                    return (\n                      <tr key={rIdx} className={isBaseOcc ? \'bg-[#FEF3C7]/20 font-bold\' : \'\'}>\n                        <td className=\"py-2 px-2 text-left text-[#666562] font-semibold\">\n                          {occVal}% {isBaseOcc && \'\342\230\205\'}\n                        </td>\n                        {adrMultipliers.map((mVal, cIdx) => {\n                          const testAdr = Math.round(adr * (1 + mVal));\n                          const testMetrics = computeUnderwriting(\n                            adjustedDeal,\n                            testAdr,\n                            occVal,\n                            strategy,\n                            downPaymentPct,\n                            interestRate\n                          );\n                          const isHighYield = testMetrics.cashOnCashReturn >= 18;\n                          const isNegative = testMetrics.cashOnCashReturn < 0;\n\n                          return (\n                            <td\n                              key={cIdx}\n                              className={`py-2 px-2 tabular-nums ${\n                                isNegative\n                                  ? \'text-red-600 font-bold\'\n                                  : isHighYield\n                                  ? \'text-[#0B3B24] font-bold bg-[#E8F5EE]/40\'\n                                  : \'text-[#111110]\'\n                              }`}\n                            >\n                              {testMetrics.cashOnCashReturn.toFixed(1)}%\n                              <span className=\"block text-[9px] text-[#8F8D88]\">\n                                {testMetrics.dscrRatio.toFixed(2)}x\n                              </span>\n                            </td>\n                          );\n                        })}\n                      </tr>\n                    );\n                  })}\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
