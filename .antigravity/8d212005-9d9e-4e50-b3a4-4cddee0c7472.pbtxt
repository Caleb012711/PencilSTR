  file_change {
    absolute_path_uri: "file:///src/components/PipelineDrawer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { PropertyDeal } from \'../types\';\nimport { formatCurrency } from \'../utils/calculator\';\n\ninterface PipelineDrawerProps {\n  isOpen: boolean;\n  onClose: () => void;\n  savedDeals: PropertyDeal[];\n  onSelectDeal: (deal: PropertyDeal) => void;\n  onRemoveDeal: (dealId: string) => void;\n  onNavigateToUnderwriter: () => void;\n}\n\nexport const PipelineDrawer: React.FC<PipelineDrawerProps> = ({\n  isOpen,\n  onClose,\n  savedDeals,\n  onSelectDeal,\n  onRemoveDeal,\n  onNavigateToUnderwriter,\n}) => {\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 overflow-hidden bg-black/40 backdrop-blur-xs flex justify-end\">\n      <div className=\"bg-white w-full max-w-md h-full shadow-2xl flex flex-col border-l border-[#E5E4DF] animate-in slide-in-from-right duration-200\">\n        {/* Drawer Header */}\n        <div className=\"p-6 border-b border-[#E5E4DF] flex items-center justify-between bg-[#F9F8F5]\">\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"font-extrabold text-sm font-sans tracking-tight text-[#111110]\">\n                PENCIL\n              </span>\n              <span className=\"text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-[#0B3B24]/10 text-[#0B3B24]\">\n                SAVED PIPELINE\n              </span>\n            </div>\n            <p className=\"text-xs font-mono text-[#666562] mt-1\">\n              {savedDeals.length} active cohorts bookmarked\n            </p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded hover:bg-[#E5E4DF] text-[#666562] transition-colors cursor-pointer\"\n          >\n            <span className=\"material-symbols-outlined text-[20px]\">close</span>\n          </button>\n        </div>\n\n        {/* Deals List */}\n        <div className=\"p-6 flex-1 overflow-y-auto space-y-4\">\n          {savedDeals.length === 0 ? (\n            <div className=\"text-center py-12 text-[#8F8D88] font-mono text-xs\">\n              <span className=\"material-symbols-outlined text-[36px] mb-2 block text-[#E5E4DF]\">\n                bookmark_border\n              </span>\n              <p>No properties saved yet.</p>\n              <p className=\"text-[11px] text-[#8F8D88] mt-1\">\n                Click \"Save Deal\" in the Underwriter to monitor cohorts here.\n              </p>\n            </div>\n          ) : (\n            savedDeals.map((deal) => (\n              <div\n                key={deal.id}\n                className=\"p-4 rounded-xl border border-[#E5E4DF] bg-[#F9F8F5] hover:bg-white hover:border-[#111110]/40 transition-all space-y-3\"\n              >\n                <div className=\"flex gap-3\">\n                  <img\n                    src={deal.imageUrl}\n                    alt={deal.title}\n                    className=\"w-16 h-16 rounded object-cover border border-[#E5E4DF] shrink-0\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                  <div className=\"flex-1 min-w-0\">\n                    <h4 className=\"font-bold text-xs text-[#111110] truncate\">{deal.title}</h4>\n                    <p className=\"text-[11px] font-mono text-[#666562]\">{deal.location}</p>\n                    <p className=\"text-xs font-mono font-extrabold text-[#111110] mt-1 tabular-nums\">\n                      {formatCurrency(deal.price)}\n                    </p>\n                  </div>\n                  <button\n                    onClick={() => onRemoveDeal(deal.id)}\n                    className=\"text-[#8F8D88] hover:text-red-600 transition-colors p-1\"\n                    title=\"Remove from pipeline\"\n                  >\n                    <span className=\"material-symbols-outlined text-[16px]\">delete</span>\n                  </button>\n                </div>\n\n                <div className=\"pt-2 border-t border-[#E5E4DF] flex items-center justify-between text-xs font-mono\">\n                  <span className=\"text-[10px] text-[#059669] font-bold\">\n                    {deal.beds}B / {deal.baths}Ba \302\267 ${deal.baseAdr} ADR\n                  </span>\n                  <button\n                    onClick={() => {\n                      onSelectDeal(deal);\n                      onNavigateToUnderwriter();\n                      onClose();\n                    }}\n                    className=\"text-xs font-bold text-[#111110] hover:text-[#D97706] flex items-center gap-1 cursor-pointer\"\n                  >\n                    <span>Underwrite</span>\n                    <span className=\"text-sm\">\342\206\222</span>\n                  </button>\n                </div>\n              </div>\n            ))\n          )}\n        </div>\n\n        {/* Drawer Footer */}\n        {savedDeals.length > 0 && (\n          <div className=\"p-6 border-t border-[#E5E4DF] bg-[#F9F8F5] space-y-2\">\n            <button\n              onClick={() => {\n                if (savedDeals[0]) onSelectDeal(savedDeals[0]);\n                onNavigateToUnderwriter();\n                onClose();\n              }}\n              className=\"w-full py-3 rounded bg-[#111110] text-white font-mono text-xs font-bold uppercase tracking-wider hover:bg-black transition-all cursor-pointer shadow-sm text-center\"\n            >\n              Open Active Pipeline Modeler\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
