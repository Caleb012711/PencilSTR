      arguments_json: "{\"Content\":\"export type CombatStrategy = \'solo_assault\' | \'wiglaf_flank\' | \'defensive_iron\';\\n\\nexport interface DragonEncounter {\\n  id: string;\\n  chapter: string;\\n  linesSpan: string;\\n  title: string;\\n  location: string;\\n  elevation: string;\\n  threatLevel: string;\\n  yearsAsKing: number;\\n  dragonAgeWinters: number;\\n  imageUrl: string;\\n  imageAlt: string;\\n  theftItem: {\\n    name: string;\\n    material: string;\\n    origin: string;\\n    worth: string;\\n  };\\n  beowulfStats: {\\n    ageWinters: number;\\n    armor: string;\\n    shieldType: string;\\n    weaponName: string; // Naegling\\n    weaponFate: string;\\n  };\\n  dragonStats: {\\n    breathHeatFahrenheit: number;\\n    venomPotencyPct: number;\\n    hoardValueGoldShillings: number;\\n    hoardPiecesCount: number;\\n    barrowLocation: string;\\n  };\\n  seasonalityOfRage: {\\n    period: string;\\n    phase: string;\\n    devastationScore: number;\\n    isPeak?: boolean;\\n    description: string;\\n  }[];\\n  thanesAudit: {\\n    totalThanes: number;\\n    fledToWoods: number;\\n    remainedLoyal: number;\\n    loyalWarrior: string;\\n    fatherOfLoyal: string;\\n    lineageClan: string;\\n  };\\n  verses: {\\n    lineNum: number;\\n    oldEnglish: string;\\n    modernEnglish: string;\\n    speaker: string;\\n  }[];\\n}\\n\\nexport interface HoardItem {\\n  id: string;\\n  name: string;\\n  description: string;\\n  category: \'goblet\' | \'armor\' | \'blade\' | \'torque\' | \'banner\';\\n  stolenByThrall?: boolean;\\n  valueShillings: number;\\n}\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/types/beowulf.ts\", \"toolAction\":\"Creating Beowulf types\", \"toolSummary\":\"Create Beowulf saga types\"}"
