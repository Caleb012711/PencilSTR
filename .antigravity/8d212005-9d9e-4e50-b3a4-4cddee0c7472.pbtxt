  file_change {
    absolute_path_uri: "file:///src/components/FeatureModules.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { LIVE_SWEEP_FEED } from \'../data/mockDeals\';\nimport { PropertyDeal } from \'../types\';\n\ninterface FeatureModulesProps {\n  allDeals: PropertyDeal[];\n  onSelectDeal: (deal: PropertyDeal) => void;\n  onNavigateToUnderwriter: () => void;\n  onNavigateToHoaAudit: () => void;\n}\n\nexport const FeatureModules: React.FC<FeatureModulesProps> = ({\n  allDeals,\n  onSelectDeal,\n  onNavigateToUnderwriter,\n  onNavigateToHoaAudit,\n}) => {\n  // Shock test state for Module 02\n  const [shockRate, setShockRate] = useState<number>(7.15);\n  const [loanAmount] = useState<number>(500000);\n\n  // Quick calculate monthly payment for shock test\n  const calculateShockPmt = (rate: number) => {\n    const r = (rate / 100) / 12;\n    const n = 360;\n    return Math.round((loanAmount * r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1));\n  };\n\n  const handleFeedClick = (dealId: string) => {\n    const matched = allDeals.find(d => d.id === dealId);\n    if (matched) {\n      onSelectDeal(matched);\n      window.scrollTo({ top: 320, behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <section className=\"max-w-[1360px] w-full mx-auto px-6 md:px-10 py-12\">\n      <div className=\"max-w-2xl mb-12\">\n        <span className=\"text-xs font-mono font-bold text-[#92400E] uppercase tracking-[0.2em] block mb-2\">\n          ARCHITECTURE // COGNITION\n        </span>\n        <h2 className=\"font-serif text-3xl md:text-4xl font-extrabold text-[#111110] tracking-tight mb-3\">\n          Precision Underwriting Stack.\n        </h2>\n        <p className=\"text-sm md:text-base text-[#666562] leading-relaxed font-sans\">\n          Engineered for institutional funds and ambitious private operators looking for defensive yield.\n        </p>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n        {/* Card 1: Autonomous Market Sweeps */}\n        <div className=\"bg-white p-6 rounded-xl border border-[#E5E4DF] shadow-sm flex flex-col justify-between hover:border-[#111110]/30 transition-all\">\n          <div>\n            <div className=\"flex items-center justify-between mb-4\">\n              <div className=\"w-10 h-10 rounded-lg bg-[#FEF3C7] text-[#92400E] flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-[20px]\">radar</span>\n              </div>\n              <span className=\"text-[10px] font-mono font-bold text-[#92400E] tracking-widest uppercase\">\n                MODULE 01\n              </span>\n            </div>\n            <h3 className=\"text-lg font-bold font-sans text-[#111110] mb-1.5\">\n              Autonomous Market Sweeps\n            </h3>\n            <p className=\"text-xs text-[#666562] leading-relaxed mb-4\">\n              Background agents continuously scan MLS listings and off-market wholesale lists for price cuts and motivated sellers.\n            </p>\n\n            {/* Interactive Mini-Feed Alert Preview */}\n            <div className=\"space-y-2 border-t border-[#E5E4DF] pt-3.5 mb-5\">\n              <div className=\"flex justify-between items-center mb-1\">\n                <span className=\"text-[10px] font-mono uppercase tracking-wider text-[#8F8D88] font-bold\">\n                  Live Sweep Feed\n                </span>\n                <span className=\"text-[9px] font-mono text-[#059669] flex items-center gap-1 font-semibold\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-[#059669] animate-ping\"></span>\n                  Streaming\n                </span>\n              </div>\n\n              {LIVE_SWEEP_FEED.slice(0, 3).map((item) => (\n                <div\n                  key={item.id}\n                  onClick={() => handleFeedClick(item.dealId)}\n                  className=\"p-2 rounded bg-[#F9F8F5] border border-[#E5E4DF] flex items-center justify-between text-xs font-mono hover:bg-white hover:border-[#111110]/40 transition-colors cursor-pointer\"\n                  title=\"Click to underwrite this deal\"\n                >\n                  <div>\n                    <p className=\"font-bold text-[#111110] text-[11px]\">{item.location}</p>\n                    <span className=\"text-[10px] text-[#8F8D88]\">{item.timeAgo} \302\267 {item.type}</span>\n                  </div>\n                  <span className=\"px-2 py-0.5 rounded bg-[#E8F5EE] text-[#0B3B24] font-bold text-[10px]\">\n                    {item.coc}\n                  </span>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={() => handleFeedClick(\'timberline-ridge\')}\n            className=\"pt-3 border-t border-[#E5E4DF] flex items-center justify-between text-xs font-mono font-bold text-[#111110] hover:text-[#D97706] transition-colors cursor-pointer w-full text-left\"\n          >\n            <span>REAL-TIME MLS FEEDS</span>\n            <span className=\"material-symbols-outlined text-[16px] text-[#666562]\">arrow_forward</span>\n          </button>\n        </div>\n\n        {/* Card 2: DSCR & Creative Financing */}\n        <div className=\"bg-white p-6 rounded-xl border border-[#E5E4DF] shadow-sm flex flex-col justify-between hover:border-[#111110]/30 transition-all\">\n          <div>\n            <div className=\"flex items-center justify-between mb-4\">\n              <div className=\"w-10 h-10 rounded-lg bg-[#E8F5EE] text-[#0B3B24] flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-[20px]\">tune</span>\n              </div>\n              <span className=\"text-[10px] font-mono font-bold text-[#0B3B24] tracking-widest uppercase\">\n                MODULE 02\n              </span>\n            </div>\n            <h3 className=\"text-lg font-bold font-sans text-[#111110] mb-1.5\">\n              DSCR &amp; Creative Financing\n            </h3>\n            <p className=\"text-xs text-[#666562] leading-relaxed mb-4\">\n              Instantly toggle between Conventional, DSCR, and Seller Financing terms with dynamic stress-testing for occupancy drops.\n            </p>\n\n            {/* Capital Stack Bar Preview & Quick Shock Test */}\n            <div className=\"border-t border-[#E5E4DF] pt-3.5 space-y-2.5 mb-5\">\n              <div className=\"flex justify-between items-center text-xs font-mono\">\n                <span className=\"text-[10px] uppercase tracking-wider text-[#8F8D88] font-bold\">\n                  Capital Stack Breakdown\n                </span>\n                <span className=\"font-bold text-[#111110] text-[11px]\">$660,000 Total</span>\n              </div>\n\n              {/* Stacked Visual Bar */}\n              <div className=\"w-full h-2.5 rounded-full flex overflow-hidden border border-[#E5E4DF]\">\n                <div className=\"bg-[#111110] h-full\" style={{ width: \'76%\' }} title=\"Loan Principal 76%\"></div>\n                <div className=\"bg-[#D97706] h-full\" style={{ width: \'19%\' }} title=\"Down Payment 19%\"></div>\n                <div className=\"bg-[#059669] h-full\" style={{ width: \'5%\' }} title=\"Reserves 5%\"></div>\n              </div>\n\n              {/* Legend */}\n              <div className=\"space-y-1 text-[11px] font-mono\">\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"flex items-center gap-1.5 text-[#666562]\">\n                    <span className=\"w-2 h-2 rounded-full bg-[#111110] inline-block\"></span>\n                    Loan Principal (80%)\n                  </span>\n                  <span className=\"font-bold text-[#111110]\">$500,000</span>\n                </div>\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"flex items-center gap-1.5 text-[#666562]\">\n                    <span className=\"w-2 h-2 rounded-full bg-[#D97706] inline-block\"></span>\n                    Down Payment (20%)\n                  </span>\n                  <span className=\"font-bold text-[#111110]\">$125,000</span>\n                </div>\n                <div className=\"flex justify-between items-center\">\n                  <span className=\"flex items-center gap-1.5 text-[#666562]\">\n                    <span className=\"w-2 h-2 rounded-full bg-[#059669] inline-block\"></span>\n                    Cash Reserves\n                  </span>\n                  <span className=\"font-bold text-[#111110]\">$35,000</span>\n                </div>\n              </div>\n\n              {/* Interactive Shock Test Scrubber */}\n              <div className=\"p-2 rounded bg-[#F9F8F5] border border-[#E5E4DF] mt-2\">\n                <div className=\"flex justify-between text-[10px] font-mono mb-1\">\n                  <span className=\"text-[#666562] font-semibold\">Rate Stress: {shockRate.toFixed(2)}%</span>\n                  <span className=\"font-bold text-[#111110]\">${calculateShockPmt(shockRate)}/mo P&amp;I</span>\n                </div>\n                <input\n                  type=\"range\"\n                  min={6.0}\n                  max={9.5}\n                  step={0.25}\n                  value={shockRate}\n                  onChange={(e) => setShockRate(Number(e.target.value))}\n                  className=\"w-full h-1.5 accent-[#0B3B24] cursor-pointer\"\n                />\n              </div>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onNavigateToUnderwriter}\n            className=\"pt-3 border-t border-[#E5E4DF] flex items-center justify-between text-xs font-mono font-bold text-[#111110] hover:text-[#0B3B24] transition-colors cursor-pointer w-full text-left\"\n          >\n            <span className=\"text-[#0B3B24]\">INTEREST RATE SHOCK TESTS</span>\n            <span className=\"material-symbols-outlined text-[16px] text-[#666562]\">arrow_forward</span>\n          </button>\n        </div>\n\n        {/* Card 3: 100-Page HOA & Zoning Scans */}\n        <div className=\"bg-white p-6 rounded-xl border border-[#E5E4DF] shadow-sm flex flex-col justify-between hover:border-[#111110]/30 transition-all\">\n          <div>\n            <div className=\"flex items-center justify-between mb-4\">\n              <div className=\"w-10 h-10 rounded-lg bg-[#F9F8F5] text-[#111110] border border-[#E5E4DF] flex items-center justify-center\">\n                <span className=\"material-symbols-outlined text-[20px]\">gavel</span>\n              </div>\n              <span className=\"text-[10px] font-mono font-bold text-[#111110] tracking-widest uppercase\">\n                MODULE 03\n              </span>\n            </div>\n            <h3 className=\"text-lg font-bold font-sans text-[#111110] mb-1.5\">\n              100-Page HOA &amp; Zoning Scans\n            </h3>\n            <p className=\"text-xs text-[#666562] leading-relaxed mb-4\">\n              Specialized legal LLM parses CC&amp;R PDFs to flag restrictive clauses, rental permits, parking restrictions, and quiet hours.\n            </p>\n\n            {/* Checklist Preview */}\n            <div className=\"border-t border-[#E5E4DF] pt-3.5 space-y-2 text-xs font-mono mb-5\">\n              <span className=\"text-[10px] uppercase tracking-wider text-[#8F8D88] font-bold block mb-1\">\n                Clause Audit Verification\n              </span>\n              <div className=\"p-2 rounded bg-[#F9F8F5] border border-[#E5E4DF] flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-[#059669] font-bold\">\342\234\223</span>\n                  <span className=\"font-medium text-[#111110] text-[11px]\">0-Night Minimum Stay (\302\2474.1)</span>\n                </div>\n                <span className=\"text-[10px] font-bold text-[#059669] uppercase\">Clear</span>\n              </div>\n              <div className=\"p-2 rounded bg-[#F9F8F5] border border-[#E5E4DF] flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-[#059669] font-bold\">\342\234\223</span>\n                  <span className=\"font-medium text-[#111110] text-[11px]\">County Permit Current (2026)</span>\n                </div>\n                <span className=\"text-[10px] font-bold text-[#059669] uppercase\">Active</span>\n              </div>\n              <div className=\"p-2 rounded bg-[#F9F8F5] border border-[#E5E4DF] flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-[#92400E] font-bold\">!</span>\n                  <span className=\"font-medium text-[#111110] text-[11px]\">Quiet Hours 10 PM</span>\n                </div>\n                <span className=\"text-[10px] font-bold text-[#92400E] bg-[#FEF3C7] px-1.5 py-0.5 rounded\">\n                  Noted\n                </span>\n              </div>\n              <div className=\"p-2 rounded bg-[#F9F8F5] border border-[#E5E4DF] flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"text-[#92400E] font-bold\">!</span>\n                  <span className=\"font-medium text-[#111110] text-[11px]\">Max 4 Vehicles Allowed</span>\n                </div>\n                <span className=\"text-[10px] font-bold text-[#92400E] bg-[#FEF3C7] px-1.5 py-0.5 rounded\">\n                  Tag\n                </span>\n              </div>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onNavigateToHoaAudit}\n            className=\"pt-3 border-t border-[#E5E4DF] flex items-center justify-between text-xs font-mono font-bold text-[#111110] hover:text-[#92400E] transition-colors cursor-pointer w-full text-left\"\n          >\n            <span className=\"text-[#92400E]\">ZERO-RISK CONTINGENCIES</span>\n            <span className=\"material-symbols-outlined text-[16px] text-[#666562]\">arrow_forward</span>\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
