    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\n\ninterface TrialModalProps {\n  planName: string;\n  price: string;\n  onClose: () => void;\n}\n\nexport const TrialModal: React.FC<TrialModalProps> = ({ planName, price, onClose }) => {\n  const [email, setEmail] = useState(\'\');\n  const [name, setName] = useState(\'\');\n  const [isActivated, setIsActivated] = useState(false);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsActivated(true);\n    setTimeout(() => {\n      onClose();\n    }, 2200);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 overflow-y-auto bg-black/60 backdrop-blur-sm flex items-center justify-center p-4\">\n      <div className=\"bg-white rounded-xl border border-[#E5E4DF] shadow-2xl max-w-md w-full overflow-hidden\">\n        <div className=\"p-6 border-b border-[#E5E4DF] bg-[#F9F8F5] flex justify-between items-center\">\n          <div>\n            <span className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-[#92400E] block\">\n              14-DAY INSTITUTIONAL PASS\n            </span>\n            <h3 className=\"font-serif text-xl font-bold text-[#111110]\">\n              Start {planName} Trial\n            </h3>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1 rounded hover:bg-[#E5E4DF] text-[#666562] transition-colors cursor-pointer\"\n          >\n            <span className=\"material-symbols-outlined text-[20px]\">close</span>\n          </button>\n        </div>\n\n        {isActivated ? (\n          <div className=\"p-8 text-center space-y-3\">\n            <span className=\"w-12 h-12 rounded-full bg-[#E8F5EE] text-[#059669] flex items-center justify-center mx-auto text-2xl\">\n              \342\234\223\n            </span>\n            <h4 className=\"font-bold text-lg text-[#111110]\">Trial License Activated!</h4>\n            <p className=\"text-xs font-mono text-[#666562]\">\n              Welcome aboard, {name || \'Operator\'}. Unlocking full MLS price radar and CC&amp;R AI scanning tools for {email}...\n            </p>\n          </div>\n        ) : (\n          <form onSubmit={handleSubmit} className=\"p-6 space-y-4 text-xs font-mono\">\n            <div className=\"p-3 rounded bg-[#F9F8F5] border border-[#E5E4DF] flex justify-between items-center\">\n              <div>\n                <span className=\"text-[10px] text-[#8F8D88] uppercase block\">Selected Tier</span>\n                <span className=\"font-bold text-[#111110]\">{planName}</span>\n              </div>\n              <div className=\"text-right\">\n                <span className=\"text-[10px] text-[#8F8D88] block\">Price</span>\n                <span className=\"font-bold text-[#0B3B24]\">{price}</span>\n              </div>\n            </div>\n\n            <div>\n              <label className=\"text-[#666562] block mb-1 font-semibold\">Full Name / Fund Name</label>\n              <input\n                type=\"text\"\n                required\n                placeholder=\"e.g., Marcus Vance (Vance Capital)\"\n                value={name}\n                onChange={(e) => setName(e.target.value)}\n                className=\"w-full bg-[#F9F8F5] border border-[#E5E4DF] rounded px-3 py-2 text-[#111110] focus:outline-none focus:border-[#111110]\"\n              />\n            </div>\n\n            <div>\n              <label className=\"text-[#666562] block mb-1 font-semibold\">Work / Deal Sourcing Email</label>\n              <input\n                type=\"email\"\n                required\n                placeholder=\"operator@acquisitions.com\"\n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                className=\"w-full bg-[#F9F8F5] border border-[#E5E4DF] rounded px-3 py-2 text-[#111110] focus:outline-none focus:border-[#111110]\"\n              />\n            </div>\n\n            <div className=\"pt-2 text-[11px] text-[#8F8D88] leading-relaxed\">\n              No credit card required for initial 14 days. Instant access to live MLS sweep radar and CC&amp;R zoning auditor.\n            </div>\n\n            <button\n              type=\"submit\"\n              className=\"w-full py-3 rounded bg-[#111110] text-white font-bold uppercase tracking-wider hover:bg-black transition-all cursor-pointer shadow-sm text-center\"\n            >\n              Activate 14-Day Free Access \342\206\222\n            </button>\n          </form>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
