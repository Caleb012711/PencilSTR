      arguments_json: "{\"Content\":\"import React, { useState } from \'react\';\\nimport { BEOWULF_PART_3 } from \'../data/beowulfData\';\\n\\ninterface BeowulfVerseModalProps {\\n  initialLine?: number;\\n  onClose: () => void;\\n}\\n\\nexport const BeowulfVerseModal: React.FC<BeowulfVerseModalProps> = ({\\n  initialLine = 2633,\\n  onClose,\\n}) => {\\n  const [selectedLine, setSelectedLine] = useState<number>(initialLine);\\n  const [isPlayingAudio, setIsPlayingAudio] = useState(false);\\n\\n  const activeVerse = BEOWULF_PART_3.verses.find(v => v.lineNum === selectedLine) || BEOWULF_PART_3.verses[0];\\n\\n  const handleSimulateChant = () => {\\n    setIsPlayingAudio(true);\\n    setTimeout(() => {\\n      setIsPlayingAudio(false);\\n    }, 3200);\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 overflow-y-auto bg-black/60 backdrop-blur-sm flex items-center justify-center p-4\\\">\\n      <div className=\\\"bg-white rounded-xl border border-[#E5E4DF] shadow-2xl max-w-2xl w-full overflow-hidden my-auto max-h-[85vh] flex flex-col\\\">\\n        {/* Header */}\\n        <div className=\\\"p-5 border-b border-[#E5E4DF] bg-[#F9F8F5] flex justify-between items-center\\\">\\n          <div>\\n            <span className=\\\"text-[10px] font-mono font-bold uppercase tracking-wider text-[#92400E] block\\\">\\n              COTTON VITELLIUS A. XV // LINE SCANNER\\n            </span>\\n            <h3 className=\\\"font-serif text-xl font-bold text-[#111110]\\\">\\n              Beowulf Codex: Line \302\247{activeVerse.lineNum}\\n            </h3>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"p-1 rounded hover:bg-[#E5E4DF] text-[#666562] transition-colors cursor-pointer\\\"\\n          >\\n            <span className=\\\"material-symbols-outlined text-[20px]\\\">close</span>\\n          </button>\\n        </div>\\n\\n        {/* Verse Selector Strip */}\\n        <div className=\\\"p-3 border-b border-[#E5E4DF] bg-white flex items-center gap-2 overflow-x-auto text-xs font-mono\\\">\\n          <span className=\\\"text-[10px] text-[#8F8D88] uppercase shrink-0 font-bold\\\">Key Verses:</span>\\n          {BEOWULF_PART_3.verses.map((v) => (\\n            <button\\n              key={v.lineNum}\\n              onClick={() => setSelectedLine(v.lineNum)}\\n              className={`px-2.5 py-1 rounded transition-colors shrink-0 cursor-pointer ${\\n                v.lineNum === activeVerse.lineNum\\n                  ? \'bg-[#111110] text-white font-bold\'\\n                  : \'bg-[#F9F8F5] border border-[#E5E4DF] text-[#111110] hover:bg-[#E5E4DF]\'\\n              }`}\\n            >\\n              \302\247{v.lineNum} ({v.speaker.split(\' \')[0]})\\n            </button>\\n          ))}\\n        </div>\\n\\n        {/* Verse Body */}\\n        <div className=\\\"p-6 overflow-y-auto space-y-5 text-xs font-mono\\\">\\n          <div>\\n            <span className=\\\"text-[10px] text-[#8F8D88] uppercase block mb-1\\\">Speaker &amp; Context</span>\\n            <p className=\\\"font-bold text-sm text-[#111110]\\\">{activeVerse.speaker}</p>\\n          </div>\\n\\n          <div className=\\\"p-4 rounded-lg bg-[#F9F8F5] border border-[#E5E4DF] space-y-2\\\">\\n            <div className=\\\"flex justify-between items-center\\\">\\n              <span className=\\\"text-[10px] font-bold text-[#92400E] uppercase\\\">\\n                Original Old English (Alliterative Long-Line)\\n              </span>\\n              <button\\n                onClick={handleSimulateChant}\\n                className=\\\"text-[11px] font-bold text-[#111110] hover:text-[#92400E] flex items-center gap-1 transition-colors cursor-pointer\\\"\\n              >\\n                <span className=\\\"material-symbols-outlined text-[16px]\\\">\\n                  {isPlayingAudio ? \'volume_up\' : \'play_circle\'}\\n                </span>\\n                <span>{isPlayingAudio ? \'Reciting Verse...\' : \'Play Sc\305\215p Chant\'}</span>\\n              </button>\\n            </div>\\n            <p className=\\\"text-sm font-serif italic text-[#111110] leading-relaxed tracking-wide pt-1\\\">\\n              \\\"{activeVerse.oldEnglish}\\\"\\n            </p>\\n          </div>\\n\\n          <div className=\\\"p-4 rounded-lg bg-white border border-[#E5E4DF] space-y-1.5\\\">\\n            <span className=\\\"text-[10px] font-bold text-[#0B3B24] uppercase\\\">\\n              Modern English Translation\\n            </span>\\n            <p className=\\\"text-xs text-[#111110] leading-relaxed font-sans\\\">\\n              \\\"{activeVerse.modernEnglish}\\\"\\n            </p>\\n          </div>\\n\\n          <div className=\\\"p-3.5 rounded bg-[#FEF3C7]/40 border border-[#D97706]/30 text-[11px] text-[#92400E] space-y-1\\\">\\n            <strong className=\\\"block font-bold\\\">Poetic Apparatus Note:</strong>\\n            <span>\\n              The Old English poet uses caesura (mid-line pause) and alliteration on stressed syllables to drive the rhythm, embodying the somber elegy of an aging hero whose physical strength outmatches forged swords.\\n            </span>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"p-4 border-t border-[#E5E4DF] bg-[#F9F8F5] flex justify-between items-center\\\">\\n          <span className=\\\"text-[11px] font-mono text-[#8F8D88]\\\">\\n            Cotton Vitellius A. xv \302\267 British Library\\n          </span>\\n          <button\\n            onClick={onClose}\\n            className=\\\"px-4 py-2 rounded bg-[#111110] text-white text-xs font-mono font-bold uppercase hover:bg-black transition-colors\\\"\\n          >\\n            Return\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/components/BeowulfVerseModal.tsx\", \"toolAction\":\"Creating Beowulf verse modal\", \"toolSummary\":\"Create Beowulf verse reader modal\"}"
