  file_change {
    absolute_path_uri: "file:///src/components/LenderMemoModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { PropertyDeal } from \'../types\';\nimport { computeUnderwriting, formatCurrency, formatPercent } from \'../utils/calculator\';\n\ninterface LenderMemoModalProps {\n  deal: PropertyDeal;\n  onClose: () => void;\n}\n\nexport const LenderMemoModal: React.FC<LenderMemoModalProps> = ({ deal, onClose }) => {\n  const [copied, setCopied] = useState(false);\n\n  const metrics = computeUnderwriting(\n    deal,\n    deal.baseAdr,\n    deal.baseOccupancy,\n    \'dscr\'\n  );\n\n  const handlePrint = () => {\n    window.print();\n  };\n\n  const handleCopyMemo = () => {\n    const text = `PENCILSTR CREDIT MEMORANDUM // DSCR UNDERWRITING\nDEAL: ${deal.title} (${deal.location}) | MLS #${deal.mlsNumber}\nPURCHASE PRICE: ${formatCurrency(deal.price)}\nLOAN AMOUNT (DSCR 80% LTV): ${formatCurrency(deal.price * 0.8)}\nINITIAL BORROWER CASH: ${formatCurrency(metrics.totalCashRequired)}\nDSCR RATIO: ${metrics.dscrRatio.toFixed(2)}x (Qualifier Standard: 1.25x)\nNET OPERATING INCOME (NOI): ${formatCurrency(metrics.noi)}\nGROSS ANNUAL STR REVENUE: ${formatCurrency(metrics.grossAnnualRevenue)} (ADR: $${deal.baseAdr}, Occ: ${deal.baseOccupancy}%)\nOPERATING EXPENSES: ${formatCurrency(metrics.operatingExpenses)}\nANNUAL DEBT SERVICE: ${formatCurrency(metrics.annualDebtService)}\nCASH-ON-CASH RETURN: ${formatPercent(metrics.cashOnCashReturn)}\nHOA / ZONING CLEARANCE: ${deal.hoaStatus.statusText} (${deal.hoaStatus.section})\nVERIFIED INSTITUTIONAL YIELD: Tier-1 Portfolio Grade`;\n\n    navigator.clipboard.writeText(text);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 overflow-y-auto bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6\">\n      <div className=\"bg-white rounded-xl border border-[#E5E4DF] shadow-2xl max-w-4xl w-full overflow-hidden my-auto max-h-[92vh] flex flex-col\">\n        {/* Header Controls (no-print) */}\n        <div className=\"px-6 py-4 border-b border-[#E5E4DF] bg-[#F9F8F5] flex items-center justify-between no-print\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"font-extrabold text-sm font-sans tracking-tight text-[#111110]\">PENCIL</span>\n            <span className=\"text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-[#D97706]/15 text-[#92400E]\">\n              STR CREDIT MEMO\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handleCopyMemo}\n              className=\"px-3 py-1.5 rounded border border-[#E5E4DF] bg-white text-xs font-mono font-semibold text-[#111110] hover:bg-[#F9F8F5] transition-colors flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[15px]\">\n                {copied ? \'check\' : \'content_copy\'}\n              </span>\n              <span>{copied ? \'Copied\' : \'Copy\'}</span>\n            </button>\n            <button\n              onClick={handlePrint}\n              className=\"px-3.5 py-1.5 rounded bg-[#111110] text-white text-xs font-mono font-bold hover:bg-black transition-colors flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[15px] text-[#D97706]\">print</span>\n              <span>Print / Save PDF</span>\n            </button>\n            <button\n              onClick={onClose}\n              className=\"p-1.5 rounded hover:bg-[#E5E4DF] text-[#666562] transition-colors cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[20px]\">close</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Printable Memorandum Body */}\n        <div className=\"p-8 sm:p-12 overflow-y-auto font-mono text-xs text-[#111110] space-y-6\">\n          {/* Institutional Memo Header */}\n          <div className=\"border-b-2 border-[#111110] pb-6 flex flex-col sm:flex-row justify-between items-start gap-4\">\n            <div>\n              <span className=\"text-[10px] tracking-[0.2em] uppercase font-bold text-[#8F8D88] block mb-1\">\n                INSTITUTIONAL DEBT SYNDICATION // CREDIT COMMITTEE MEMO\n              </span>\n              <h1 className=\"text-2xl font-serif font-extrabold text-[#111110]\">\n                {deal.title}\n              </h1>\n              <p className=\"text-xs text-[#666562] mt-1\">\n                {deal.location} \302\267 MLS #{deal.mlsNumber} \302\267 Built/Turnkey Ready\n              </p>\n            </div>\n            <div className=\"text-right sm:text-right font-mono text-xs\">\n              <span className=\"text-[10px] text-[#8F8D88] block\">MEMO REF NO.</span>\n              <span className=\"font-bold\">STR-DSCR-2025-0489</span>\n              <span className=\"text-[10px] text-[#8F8D88] block mt-2\">DATE OF AUDIT</span>\n              <span className=\"font-bold\">{new Date().toLocaleDateString(\'en-US\', { dateStyle: \'medium\' })}</span>\n            </div>\n          </div>\n\n          {/* Key Underwriting Highlights Grid */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 rounded-lg bg-[#F9F8F5] border border-[#E5E4DF]\">\n            <div>\n              <span className=\"text-[10px] text-[#8F8D88] block uppercase\">Purchase Price</span>\n              <span className=\"text-base font-bold text-[#111110] tabular-nums\">{formatCurrency(deal.price)}</span>\n            </div>\n            <div>\n              <span className=\"text-[10px] text-[#8F8D88] block uppercase\">Requested Loan</span>\n              <span className=\"text-base font-bold text-[#111110] tabular-nums\">{formatCurrency(deal.price * 0.8)} (80% LTV)</span>\n            </div>\n            <div>\n              <span className=\"text-[10px] text-[#8F8D88] block uppercase\">DSCR Debt Coverage</span>\n              <span className=\"text-base font-bold text-[#0B3B24] tabular-nums\">{metrics.dscrRatio.toFixed(2)}x (Min: 1.25x)</span>\n            </div>\n            <div>\n              <span className=\"text-[10px] text-[#8F8D88] block uppercase\">Projected CoC Yield</span>\n              <span className=\"text-base font-bold text-[#059669] tabular-nums\">{formatPercent(metrics.cashOnCashReturn)}</span>\n            </div>\n          </div>\n\n          {/* Sources and Uses Table */}\n          <div>\n            <h2 className=\"text-xs font-bold text-[#111110] uppercase tracking-wider mb-2 border-b border-[#E5E4DF] pb-1\">\n              1. Sources &amp; Uses of Capital\n            </h2>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div className=\"space-y-1.5 p-3 rounded bg-white border border-[#E5E4DF]\">\n                <span className=\"text-[10px] font-bold text-[#666562] uppercase block\">Capital Sources</span>\n                <div className=\"flex justify-between\">\n                  <span>DSCR 1st Lien Mortgage (80%)</span>\n                  <span className=\"font-bold tabular-nums\">{formatCurrency(deal.price * 0.8)}</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span>Borrower Equity Down Payment (20%)</span>\n                  <span className=\"font-bold tabular-nums\">{formatCurrency(deal.price * 0.2)}</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span>Borrower Working Capital Reserve</span>\n                  <span className=\"font-bold tabular-nums\">{formatCurrency(deal.capitalStack.reserves)}</span>\n                </div>\n                <div className=\"flex justify-between pt-1 border-t border-[#E5E4DF] font-bold\">\n                  <span>Total Capital Sourced</span>\n                  <span className=\"tabular-nums\">{formatCurrency(deal.price + deal.capitalStack.reserves)}</span>\n                </div>\n              </div>\n\n              <div className=\"space-y-1.5 p-3 rounded bg-white border border-[#E5E4DF]\">\n                <span className=\"text-[10px] font-bold text-[#666562] uppercase block\">Capital Uses</span>\n                <div className=\"flex justify-between\">\n                  <span>Property Acquisition Contract</span>\n                  <span className=\"font-bold tabular-nums\">{formatCurrency(deal.price)}</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span>Loan Origination &amp; Title Closing</span>\n                  <span className=\"font-bold tabular-nums\">{formatCurrency(deal.price * 0.02)}</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span>6-Month Debt Service Reserve</span>\n                  <span className=\"font-bold tabular-nums\">{formatCurrency(metrics.monthlyDebtService * 6)}</span>\n                </div>\n                <div className=\"flex justify-between pt-1 border-t border-[#E5E4DF] font-bold\">\n                  <span>Total Funds Applied</span>\n                  <span className=\"tabular-nums\">{formatCurrency(deal.price + deal.price * 0.02 + metrics.monthlyDebtService * 6)}</span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Pro Forma Summary */}\n          <div>\n            <h2 className=\"text-xs font-bold text-[#111110] uppercase tracking-wider mb-2 border-b border-[#E5E4DF] pb-1\">\n              2. Annual Pro-Forma Cash Flow Statement\n            </h2>\n            <div className=\"border border-[#E5E4DF] rounded divide-y divide-[#E5E4DF]\">\n              <div className=\"px-4 py-2 flex justify-between bg-[#F9F8F5]\">\n                <span className=\"font-bold text-[#111110]\">Gross Potential STR Revenue ({deal.baseOccupancy}% Occ, ${deal.baseAdr} ADR)</span>\n                <span className=\"font-bold text-[#111110] tabular-nums\">{formatCurrency(metrics.totalRevenue)}</span>\n              </div>\n              <div className=\"px-4 py-1.5 flex justify-between text-[#666562]\">\n                <span>- Platform Booking &amp; Channel Fees (3%)</span>\n                <span className=\"tabular-nums\">-{formatCurrency(metrics.grossAnnualRevenue * 0.03)}</span>\n              </div>\n              <div className=\"px-4 py-1.5 flex justify-between text-[#666562]\">\n                <span>- Professional Management Fee (15%)</span>\n                <span className=\"tabular-nums\">-{formatCurrency(metrics.grossAnnualRevenue * 0.15)}</span>\n              </div>\n              <div className=\"px-4 py-1.5 flex justify-between text-[#666562]\">\n                <span>- Cleaning &amp; Turnover Maintenance</span>\n                <span className=\"tabular-nums\">-{formatCurrency(metrics.cleaningRevenue)}</span>\n              </div>\n              <div className=\"px-4 py-1.5 flex justify-between text-[#666562]\">\n                <span>- Real Estate Property Taxes</span>\n                <span className=\"tabular-nums\">-{formatCurrency(deal.expenses.propertyTaxesAnnual)}</span>\n              </div>\n              <div className=\"px-4 py-1.5 flex justify-between text-[#666562]\">\n                <span>- Hazard, Wind &amp; Commercial STR Liability Policy</span>\n                <span className=\"tabular-nums\">-{formatCurrency(deal.expenses.insuranceAnnual)}</span>\n              </div>\n              <div className=\"px-4 py-1.5 flex justify-between text-[#666562]\">\n                <span>- High-Speed Utilities, Hot Tub &amp; Groundskeeping</span>\n                <span className=\"tabular-nums\">-{formatCurrency(deal.expenses.utilitiesMonthly * 12)}</span>\n              </div>\n              <div className=\"px-4 py-1.5 flex justify-between text-[#666562]\">\n                <span>- Capital Expenditure / Maintenance Reserve (5%)</span>\n                <span className=\"tabular-nums\">-{formatCurrency(metrics.grossAnnualRevenue * 0.05)}</span>\n              </div>\n              <div className=\"px-4 py-2 flex justify-between bg-[#F9F8F5] font-bold border-t-2 border-[#E5E4DF]\">\n                <span className=\"text-[#0B3B24]\">Net Operating Income (NOI) Available for Debt</span>\n                <span className=\"text-[#0B3B24] tabular-nums\">{formatCurrency(metrics.noi)}</span>\n              </div>\n              <div className=\"px-4 py-1.5 flex justify-between font-bold text-[#111110]\">\n                <span>Annual Debt Service ({deal.financingPreset.dscr.interestRate}% 30-Year P&amp;I)</span>\n                <span className=\"tabular-nums\">-{formatCurrency(metrics.annualDebtService)}</span>\n              </div>\n              <div className=\"px-4 py-2 flex justify-between bg-[#111110] text-white font-extrabold\">\n                <span className=\"text-[#FEF3C7]\">Net Levered Pre-Tax Annual Cash Flow</span>\n                <span className=\"tabular-nums text-sm\">+{formatCurrency(metrics.netCashFlowAnnual)}</span>\n              </div>\n            </div>\n          </div>\n\n          {/* Legal / CC&R Covenant Confirmation */}\n          <div className=\"p-4 rounded bg-[#F9F8F5] border border-[#E5E4DF] space-y-1.5\">\n            <span className=\"text-[10px] font-bold text-[#0B3B24] uppercase tracking-wider block\">\n              3. Legal Title &amp; Zoning Validation\n            </span>\n            <p className=\"text-xs text-[#111110]\">\n              Covenants, Conditions &amp; Restrictions: <strong className=\"font-bold\">{deal.hoaStatus.statusText}</strong> ({deal.hoaStatus.section}).\n            </p>\n            <p className=\"text-[11px] text-[#666562]\">\n              The Subject Property possesses unrestricted rights for nightly vacation rentals. No 30-day minimum lease clauses or commercial restrictions are encumbering the title.\n            </p>\n          </div>\n\n          {/* Signoff Blocks */}\n          <div className=\"pt-6 border-t border-[#E5E4DF] flex justify-between items-end text-[10px] text-[#8F8D88]\">\n            <div>\n              <p className=\"font-bold text-[#111110] text-xs\">PENCILSTR CAPITAL UNDERWRITING DIVISION</p>\n              <p>Autonomous AI Syndication Protocol v3.0</p>\n            </div>\n            <div className=\"text-right\">\n              <p className=\"font-bold text-[#111110]\">STATUS: APPROVED FOR INSTITUTIONAL TERM SHEET</p>\n              <p>Underwritten according to Secondary Market DSCR Guidelines</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
