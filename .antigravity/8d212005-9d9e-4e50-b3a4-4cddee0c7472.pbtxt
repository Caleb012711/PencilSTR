        replacement_content: "import React, { useState } from \'react\';\n\ninterface NavbarProps {\n  appMode: \'beowulf\' | \'pencilstr\';\n  onToggleAppMode: (mode: \'beowulf\' | \'pencilstr\') => void;\n  activeTab: \'scanner\' | \'underwriter\' | \'hoa-audit\' | \'pricing\';\n  onSelectTab: (tab: \'scanner\' | \'underwriter\' | \'hoa-audit\' | \'pricing\') => void;\n  savedDealsCount: number;\n  onOpenPipeline: () => void;\n  onOpenAuthModal: () => void;\n  onOpenTestament?: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  appMode,\n  onToggleAppMode,\n  activeTab,\n  onSelectTab,\n  savedDealsCount,\n  onOpenPipeline,\n  onOpenAuthModal,\n  onOpenTestament,\n}) => {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  return (\n    <header className=\"sticky top-0 w-full z-50 bg-[#F5F4F0]/90 backdrop-blur-md border-b border-[#EBEAE6]\">\n      <div className=\"h-16 w-full max-w-[1360px] mx-auto px-6 md:px-10 flex items-center justify-between\">\n        {/* Brand Zone */}\n        <div className=\"flex items-center gap-4\">\n          <button\n            onClick={() => {\n              onSelectTab(\'scanner\');\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            className=\"flex items-center gap-2 group text-left cursor-pointer focus:outline-none\"\n          >\n            <span className=\"font-extrabold tracking-tight text-lg text-[#111110] font-sans\">\n              {appMode === \'beowulf\' ? \'BEOWULF\' : \'PENCIL\'}\n            </span>\n            <span className=\"text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-[#D97706]/15 text-[#92400E] tracking-wide\">\n              {appMode === \'beowulf\' ? \'PART 3 \360\237\220\211\' : \'STR\'}\n            </span>\n          </button>\n\n          {/* Mode Switcher Pill */}\n          <div className=\"hidden sm:inline-flex items-center p-0.5 rounded-full border border-[#E5E4DF] bg-white text-[11px] font-mono font-bold shadow-xs\">\n            <button\n              onClick={() => onToggleAppMode(\'beowulf\')}\n              className={`px-3 py-1 rounded-full transition-all cursor-pointer ${\n                appMode === \'beowulf\'\n                  ? \'bg-[#111110] text-white shadow-xs\'\n                  : \'text-[#666562] hover:text-[#111110]\'\n              }`}\n            >\n              The Dragon &amp; King\n            </button>\n            <button\n              onClick={() => onToggleAppMode(\'pencilstr\')}\n              className={`px-3 py-1 rounded-full transition-all cursor-pointer ${\n                appMode === \'pencilstr\'\n                  ? \'bg-[#111110] text-white shadow-xs\'\n                  : \'text-[#666562] hover:text-[#111110]\'\n              }`}\n            >\n              PencilSTR Terminal\n            </button>\n          </div>\n        </div>\n\n        {/* Navigation Links Zone */}\n        <nav className=\"hidden md:flex items-center gap-8 text-[13px] font-medium text-[#666562]\">\n          {appMode === \'beowulf\' ? (\n            <>\n              <button\n                onClick={() => {\n                  onSelectTab(\'scanner\');\n                  window.scrollTo({ top: 0, behavior: \'smooth\' });\n                }}\n                className=\"text-[#111110] font-semibold transition-colors cursor-pointer py-1 border-b-2 border-[#111110]\"\n              >\n                Earnaness Barrow\n              </button>\n              <button\n                onClick={onOpenTestament}\n                className=\"hover:text-[#111110] transition-colors cursor-pointer py-1\"\n              >\n                King\'s Testament\n              </button>\n              <button\n                onClick={() => {\n                  const el = document.getElementById(\'beowulf-codex\');\n                  if (el) el.scrollIntoView({ behavior: \'smooth\' });\n                }}\n                className=\"hover:text-[#111110] transition-colors cursor-pointer py-1\"\n              >\n                Three Figures\n              </button>\n              <button\n                onClick={() => onToggleAppMode(\'pencilstr\')}\n                className=\"hover:text-[#111110] transition-colors cursor-pointer py-1 text-[#92400E] font-mono text-xs\"\n              >\n                Switch to STR Model \342\206\222\n              </button>\n            </>\n          ) : (\n            <>\n              <button\n                onClick={() => onSelectTab(\'scanner\')}\n                className={`transition-colors cursor-pointer py-1 ${\n                  activeTab === \'scanner\'\n                    ? \'text-[#111110] font-semibold border-b-2 border-[#111110]\'\n                    : \'hover:text-[#111110]\'\n                }`}\n              >\n                Scanner\n              </button>\n              <button\n                onClick={() => onSelectTab(\'underwriter\')}\n                className={`transition-colors cursor-pointer py-1 ${\n                  activeTab === \'underwriter\'\n                    ? \'text-[#111110] font-semibold border-b-2 border-[#111110]\'\n                    : \'hover:text-[#111110]\'\n                }`}\n              >\n                Underwriter\n              </button>\n              <button\n                onClick={() => onSelectTab(\'hoa-audit\')}\n                className={`transition-colors cursor-pointer py-1 ${\n                  activeTab === \'hoa-audit\'\n                    ? \'text-[#111110] font-semibold border-b-2 border-[#111110]\'\n                    : \'hover:text-[#111110]\'\n                }`}\n              >\n                HOA Audit\n              </button>\n              <button\n                onClick={() => onSelectTab(\'pricing\')}\n                className={`transition-colors cursor-pointer py-1 ${\n                  activeTab === \'pricing\'\n                    ? \'text-[#111110] font-semibold border-b-2 border-[#111110]\'\n      