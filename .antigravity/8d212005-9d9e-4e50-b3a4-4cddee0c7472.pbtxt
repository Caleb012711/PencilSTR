        }
        lines {
          text: "      oldEnglish: \'Ic gene\303\260de fela g\305\253\303\260a on geogo\303\260e; gyt ic wylle, fr\305\215d folces weard, f\307\243h\303\260e s\304\223can, m\307\243r\303\260u fremman.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
